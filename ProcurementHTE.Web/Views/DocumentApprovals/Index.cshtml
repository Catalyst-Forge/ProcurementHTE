@using ProcurementHTE.Core.Models
@model IEnumerable<DocumentApprovals>
@{
    ViewData["Title"] = "Document Approvals";
    var jobTypes = ViewBag.JobTypes as List<JobTypes> ?? new();
    var selectedJobType = Context.Request.Query["jobTypeId"].ToString();
    var inProgress = ViewBag.InProgressUsage as ProcurementHTE.Core.Models.DTOs.InProgressProcurementUsage
        ?? ProcurementHTE.Core.Models.DTOs.InProgressProcurementUsage.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Document Approvals</h1>
        <p class="text-muted mb-0">Kelola urutan approval untuk setiap mapping Job Type - Document.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Langkah Approval Baru</a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const handler = (event) => {
                const btn = event.target && event.target.closest(".js-da-delete");
                if (!btn) return;
                event.preventDefault();

                const form = btn.closest("form");
                if (!form) return;

                const title = btn.dataset.title || "Hapus langkah approval ini?";
                const text = btn.dataset.message || "Admin bisa memulihkannya dari menu Data Terhapus.";

                const submitForm = () => {
                    form.dataset.confirming = "true";
                    if (typeof form.requestSubmit === "function") {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                };

                if (window.Swal && typeof window.Swal.fire === "function") {
                    window.Swal.fire({
                        icon: "warning",
                        title: title,
                        text: text,
                        showCancelButton: true,
                        confirmButtonText: "Ya, hapus",
                        cancelButtonText: "Batal",
                        confirmButtonColor: "var(--dx-danger)",
                        cancelButtonColor: "var(--dx-ink-muted)",
                        focusCancel: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            submitForm();
                        }
                    });
                } else {
                    if (window.confirm(text)) {
                        submitForm();
                    }
                }
            };

            document.addEventListener("click", handler);
        })();
    </script>
}

<form method="get" class="border rounded-3 p-3 mb-3 d-flex flex-wrap gap-2 align-items-center">
    <div class="w-auto">
        <label for="filterJobType" class="form-label small text-muted mb-1">Filter Job Type</label>
        <select id="filterJobType" class="form-select" name="jobTypeId" data-auto-submit
                asp-items="@(new SelectList(jobTypes, "JobTypeId", "TypeName", selectedJobType))">
            <option value="">Semua Job Type</option>
        </select>
    </div>
    <div class="ms-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i> Muat ulang</button>
    </div>
</form>

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mobile-table">
        <thead class="table-light">
            <tr>
                <th scope="col">Job Type</th>
                <th scope="col">Document</th>
                <th scope="col">Role</th>
                <th scope="col" class="text-center">Level</th>
                <th scope="col" class="text-center">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Belum ada langkah approval.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.JobTypeDocument?.JobType?.TypeName</td>
                        <td>@item.JobTypeDocument?.DocumentType?.Name</td>
                        <td>@item.Role?.Name</td>
                        <td class="text-center">@item.Level</td>
                        <td class="text-center">
                            <div class="row-actions">
                                <a aria-label="Edit" title="Edit" asp-action="Edit" asp-route-id="@item.DocumentApprovalId" class="btn btn-row">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                @{
                                    var deleteTitle = "Hapus langkah approval ini?";
                                    var running = item.JobTypeDocument == null
                                        ? 0
                                        : inProgress.Count(item.JobTypeDocument.JobTypeId, item.JobTypeDocument.ProcurementCategory);
                                    var deleteMessage =
                                        $"Job Type: {item.JobTypeDocument?.JobType?.TypeName ?? "-"}, Document: {item.JobTypeDocument?.DocumentType?.Name ?? "-"}, Role: {item.Role?.Name ?? "-"}, Level: {item.Level}."
                                        + (running > 0
                                            ? $" Perhatian: {running} procurement yang sedang berjalan langsung memakai urutan approval tanpa langkah ini."
                                            : string.Empty);
                                }
                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline delete-form"
                                      hx-boost="false"
                                      hx-ignore="true"
                                      data-confirm-title="@deleteTitle"
                                      data-confirm-message="@System.Text.Encodings.Web.HtmlEncoder.Default.Encode(deleteMessage)"
                                      data-loading-overlay="true">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.DocumentApprovalId" />
                                    <button type="button"
                                            class="btn btn-row btn-row--danger js-da-delete"
                                            aria-label="Hapus"
                                            title="Hapus"
                                            data-title="@deleteTitle"
                                            data-message="@deleteMessage">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
