@model ProcurementHTE.Core.Models.Procurement
@{
    var pics = new (string Label, string? Name)[]
    {
        ("PIC APPO", Model.PicAppo),
        ("PIC AP-Invoice", Model.PicApInvoice),
        ("PIC AR", Model.PicAr),
    };
}
<!-- PIC per bagian keuangan, diisi manual di tabel masing-masing -->
<article class="card shadow-sm mb-3 rounded-4">
    <header class="card-header mt-2 fw-semibold bg-transparent border-bottom-0">
        <h2 class="card-title mb-0 h5"><i class="bi bi-people text-primary me-1"></i> PIC Keuangan</h2>
    </header>
    <hr class="mx-3 my-2" />
    <div class="card-body">
        @for (var i = 0; i < pics.Length; i++)
        {
            var (label, name) = pics[i];
            <div class="@(i < pics.Length - 1 ? "mb-3 pb-3 border-bottom" : "mb-0")">
                <div class="fw-semibold text-uppercase text-secondary small mb-1">@label</div>
                <div class="fw-medium text-secondary-emphasis">
                    <i class="bi bi-person me-1" aria-hidden="true"></i> @(string.IsNullOrWhiteSpace(name) ? "-" : name)
                </div>
            </div>
        }
    </div>
</article>
