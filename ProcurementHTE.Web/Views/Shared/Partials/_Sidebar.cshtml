@using ProcurementHTE.Web.Navigation
@{
    // Menu groups and their role rules live in Navigation/SidebarMenu.cs.
    var sections = SidebarMenu.For(User);
}

<aside class="sidebar-panel bg-body-tertiary text-dark-emphasis d-flex flex-column align-items-start px-3 pt-4 border-end h-100 sticky-top overflow-y-auto overflow-x-hidden" hx-boost="true" hx-target="#app-content" hx-push-url="true" hx-indicator="#content-loading">
    <div class="d-flex w-100 justify-content-between">
        <a href="@(Url.Content("~/"))" class="sidebar-brand text-decoration-none d-flex align-items-center gap-2 ps-1 pb-3 me-md-0 me-md-auto" aria-label="Docutrax, ke beranda">
            <picture>
                <source srcset="~/images/docutrax-symbol.webp" type="image/webp" />
                <img class="sidebar-brand-symbol" src="~/images/docutrax-symbol.png" alt="" width="48" height="24" />
            </picture>
            <picture>
                <source srcset="~/images/docutrax-wordmark.webp" type="image/webp" />
                <img class="sidebar-brand-wordmark" src="~/images/docutrax-wordmark.png" alt="Docutrax" width="105" height="13" />
            </picture>
        </a>
        <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
    </div>

    <nav class="sidebar-nav d-flex flex-column flex-grow-1 w-100" aria-label="Menu utama">
        @for (var s = 0; s < sections.Count; s++)
        {
            var menuGroup = sections[s];
            var labelId = $"sidebar-section-{s}";

            <div class="sidebar-section">
                @if (menuGroup.Label != null)
                {
                    <p class="sidebar-section-label" id="@labelId">@(menuGroup.Label)</p>
                }
                <ul class="nav flex-column flex-nowrap w-100" aria-labelledby="@(menuGroup.Label != null ? labelId : null)">
                    @foreach (var item in menuGroup.Items)
                    {
                        <li class="nav-item w-100">
                            <a class="nav-link link-secondary rounded-1 d-flex align-items-center @(Html.ActiveClass(controllers: item.MatchControllers, actions: item.ActiveActions))"
                               data-nav-controller="@string.Join(",", item.MatchControllers)"
                               data-nav-action="@(item.ActiveActions != null ? string.Join(",", item.ActiveActions) : null)"
                               asp-controller="@item.Controller"
                               asp-action="@item.Action"
                               data-page="@item.DataPage"
                               hx-boost="@(item.HxBoost ? null : "false")">
                                <i class="bi @item.Icon" aria-hidden="true"></i>
                                <span class="ms-1">@item.Label</span>
                                @if (item.ShowPendingApprovalBadge)
                                {
                                    @* Filled in live by notifications-core.js via SignalR. *@
                                    <span class="badge rounded-pill bg-danger ms-auto pending-approval-badge" style="display: none;">0</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="sidebar-footer mt-auto w-100">
            <hr class="w-100" />
            <ul class="nav flex-column flex-nowrap w-100 pb-4">
                <li class="nav-item w-100">
                    <a class="nav-link link-secondary rounded-1 d-flex align-items-center @(Html.ActiveClass(controllers: new[] { "Account" }, actions: new[] { "Settings" }))"
                       data-nav-controller="Account"
                       data-nav-action="Settings"
                       asp-controller="Account"
                       asp-action="Settings"
                       data-page="Settings">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                        <span class="ms-1">Settings</span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>
</aside>
