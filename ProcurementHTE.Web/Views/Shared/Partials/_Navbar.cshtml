@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var fullName = user?.FullName;
    var email = user?.Email;
}

<nav class="navbar navbar-expand navbar-light bg-white shadow-sm mb-3">
  <div class="container-fluid flex-nowrap">
    @* On phones and tablets the sidebar is an offcanvas; this is its menu button. *@
    <button class="btn border d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Buka menu">
      <i class="bi bi-list fs-5"></i>
    </button>

    <div class="d-flex align-items-center ms-auto">
      <ul class="navbar-nav flex-row align-items-center gap-1 gap-sm-2">
        @if (User.Identity?.IsAuthenticated == true) {
          <!-- Notification Bell -->
          <li class="nav-item dropdown">
            <button type="button" class="btn btn-sm fs-4 position-relative" id="dropdownNotification" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Notifikasi" aria-label="Notifikasi">
              <i class="bi bi-bell"></i>
              <span class="notification-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                0
              </span>
            </button>

            <div class="dropdown-menu dropdown-menu-end shadow notification-dropdown" aria-labelledby="dropdownNotification" style="width: min(360px, calc(100vw - 1.5rem)); max-height: 450px;">
              <div class="dropdown-header d-flex justify-content-between align-items-center py-2 px-3 border-bottom">
                <span class="fw-semibold">Notifikasi</span>
                <button type="button" class="btn btn-sm btn-link text-decoration-none mark-all-read-btn p-0">
                  <i class="bi bi-check2-all"></i> Tandai Semua Dibaca
                </button>
              </div>
              <div class="notification-list" style="max-height: 350px; overflow-y: auto;">
                <div class="text-center text-muted py-4">
                  <i class="bi bi-hourglass-split fs-2"></i>
                  <p class="mb-0 mt-2">Memuat notifikasi...</p>
                </div>
              </div>
              <div class="dropdown-footer text-center py-2 border-top d-flex justify-content-between px-3">
                <a href="#" class="text-decoration-none small" onclick="window.notificationSystem.loadNotifications(); return false;">
                  <i class="bi bi-arrow-clockwise"></i> Muat Ulang
                </a>
                <a asp-controller="Dashboard" asp-action="Notifications" class="text-decoration-none small fw-semibold text-primary"
                   hx-get='@Url.Action("Notifications", "Dashboard")'
                   hx-target="#app-content"
                   hx-push-url="true">
                  <i class="bi bi-list-ul"></i> Lihat Semua
                </a>
              </div>
            </div>
          </li>
          
          <li class="nav-item dropdown">
            <button type="button" class="btn btn-sm fs-4 dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Akun"><i class="bi bi-person-circle"></i></button>

            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownUser">
              @* The header only has room for the name and email from md up; on phones they lead the menu. *@
              <li class="d-md-none px-3 pt-1 pb-2" style="max-width: calc(100vw - 1.5rem);">
                <div class="fw-semibold text-truncate">@fullName</div>
                <small class="text-muted d-block text-truncate">@email</small>
              </li>
              <li class="d-md-none"><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item"
                   href="@Url.Action("Settings", "Account")"
                   hx-get='@Url.Action("Settings", "Account")'
                   hx-target="#app-content"
                   hx-push-url="true"
                   data-nav-controller="Account"
                   data-nav-action="Settings">Profil &amp; Keamanan</a>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <form asp-action="Logout" asp-controller="Auth" method="post" class="" hx-boost="false" id="logout-form">
                  <button type="submit" class="dropdown-item">Sign Out</button>
                </form>
              </li>
            </ul>
          </li>

          <li class="d-none d-md-flex flex-column ms-2 lh-sm">
            <span>@fullName</span>
            <small class="text-muted">@email</small>
          </li>
        } else {
          <li class="nav-item"><a asp-controller="Auth" asp-action="Login" class="nav-link">Login</a></li>
        }
      </ul>
    </div>
  </div>
</nav>

