@using System.Globalization
@using ProcurementHTE.Web.Navigation
@{
    var idCulture = CultureInfo.GetCultureInfo("id-ID");
    var start = (Model.Page - 1) * Model.PageSize + 1;
    if (Model.Total == 0) { start = 0; }
    var end = Math.Min(Model.Page * Model.PageSize, Model.Total);
    var options = new[] { 10, 25, 50, 100 };
    var pageSizeId = "pageSize-" + Guid.NewGuid().ToString("N")[..8];
    int page = Model.Page;
    int totalPages = Model.TotalPages;
    var request = Context.Request;
}

<div class="pager hstack justify-content-between flex-wrap gap-2 border rounded-3 my-2 p-2">
    <div class="d-flex align-items-center flex-wrap gap-2">
        <span class="small">
            Menampilkan <strong>@(((int)start).ToString("N0", idCulture))–@(((int)end).ToString("N0", idCulture))</strong>
            dari <strong>@(((int)Model.Total).ToString("N0", idCulture))</strong> data
        </span>

        <form method="get" class="d-inline-flex align-items-center">
            <label for="@pageSizeId" class="me-1 small text-muted">Tampilkan</label>
            <select id="@pageSizeId" name="pageSize" class="form-select form-select-sm w-auto" data-auto-submit data-reset-page>
                @foreach (var s in options) {
                    <option value="@s" selected="@(Model.PageSize == s ? "selected" : null)">@s</option>
                }
            </select>
            <span class="ms-1 small text-muted">per halaman</span>
            <input type="hidden" name="page" value="@Model.Page" />
            @foreach (var item in request.Query.Where(q => q.Key is not ("page" or "pageSize"))) {
                foreach (var value in item.Value) {
                    <input type="hidden" name="@item.Key" value="@value" />
                }
            }
        </form>
    </div>

    <partial name="_PageLinks" model="@(new PageLinks(page, totalPages, target => request.WithPage(target)))" />
</div>
