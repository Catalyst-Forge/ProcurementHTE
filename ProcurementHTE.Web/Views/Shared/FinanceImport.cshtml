@model ProcurementHTE.Web.Models.ViewModels.FinanceImportPageViewModel
@* Excel import of AP-PO, AP-Invoice, Data Accrual, or the LDP. The upload shows a preview first;
   nothing is saved until "Impor sekarang". *@
@{
    ViewData["Title"] = Model.Title;
    var plan = Model.Plan;
}

<header class="mb-3">
    <a asp-action="Index" class="back-link"><i class="bi bi-chevron-left" aria-hidden="true"></i>Kembali ke @Model.ListLabel</a>
    <h1 class="h4 mt-2 mb-1">@Model.Title</h1>
    <p class="text-muted small mb-0">
        Unggah file hasil <strong>Ekspor Excel</strong> dari menu ini yang sudah diubah. Baris dicocokkan lewat kolom
        ID Docutrax, jadi kolom itu jangan diubah. Yang diperbarui: @Model.Columns
        Kolom yang dihapus dari file tidak diubah, dan sel yang dikosongkan menghapus nilainya. Tidak ada pekerjaan yang
        dibuat atau dihapus.
    </p>
</header>

@if (plan is null)
{
    <form method="post" asp-action="ImportPreview" enctype="multipart/form-data" class="card shadow-sm rounded-4" data-loading-overlay="true">
        <div class="card-body">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <label for="file" class="form-label">File Excel (.xlsx)</label>
            <input id="file" name="file" type="file" accept=".xlsx" class="form-control mb-3" required />
            <button type="submit" class="btn btn-primary">Lihat pratinjau</button>
        </div>
    </form>
}
else
{
    <section class="card shadow-sm rounded-4 mb-3" aria-labelledby="import-summary">
        <div class="card-body">
            <h2 class="h6 mb-3" id="import-summary">Pratinjau <span class="text-muted fw-normal">· @Model.FileName</span></h2>
            <dl class="job-summary mb-3">
                <div class="job-summary__item"><dt>Isian berubah</dt><dd>@plan.Changes.Count</dd></div>
                <div class="job-summary__item"><dt>Pekerjaan berubah</dt><dd>@plan.Jobs</dd></div>
                <div class="job-summary__item"><dt>Tidak berubah</dt><dd>@plan.Unchanged</dd></div>
                <div class="job-summary__item"><dt>Baris ditolak</dt><dd class="@(plan.Rejected.Count > 0 ? "text-danger" : null)">@plan.Rejected.Count</dd></div>
            </dl>
            <form method="post" asp-action="ImportApply" class="d-flex flex-wrap gap-2" data-loading-overlay="true">
                <input type="hidden" name="token" value="@Model.Token" />
                <a asp-action="Import" class="btn btn-outline-secondary">Batal</a>
                <button type="submit" class="btn btn-primary" disabled="@(plan.Changes.Count == 0 ? "disabled" : null)">Impor sekarang</button>
            </form>
        </div>
    </section>

    @if (plan.Changes.Count > 0)
    {
        <section class="card shadow-sm rounded-4 mb-3" aria-labelledby="import-changes">
            <div class="card-body">
                <h2 class="h6 mb-2" id="import-changes">Yang akan diubah</h2>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover table-aligned align-middle mb-0 mobile-table finance-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Pekerjaan</th>
                                <th scope="col">Kolom</th>
                                <th scope="col">Dari</th>
                                <th scope="col">Menjadi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in plan.Changes)
                            {
                                <tr>
                                    <td data-label="Pekerjaan" class="finance-col-wrap text-start">@change.Job</td>
                                    <td data-label="Kolom">@change.Label</td>
                                    <td data-label="Dari">@change.From</td>
                                    <td data-label="Menjadi" class="fw-semibold">@change.To</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }

    @if (plan.Rejected.Count > 0)
    {
        <section class="card shadow-sm rounded-4 mb-3" aria-labelledby="import-rejected">
            <div class="card-body">
                <h2 class="h6 mb-2" id="import-rejected">Baris yang ditolak</h2>
                <p class="text-muted small">Baris ini tidak diubah. Perbaiki di file lalu unggah lagi kalau perlu.</p>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover table-aligned align-middle mb-0 mobile-table finance-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Baris</th>
                                <th scope="col">Pekerjaan</th>
                                <th scope="col">Alasan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in plan.Rejected)
                            {
                                <tr>
                                    <td data-label="Baris">@row.Row</td>
                                    <td data-label="Pekerjaan" class="finance-col-wrap text-start">@row.Job</td>
                                    <td data-label="Alasan" class="finance-col-wrap text-start">@row.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
}
