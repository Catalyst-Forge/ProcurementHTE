@using Microsoft.AspNetCore.Authorization
@using ProcurementHTE.Core.Common
@using ProcurementHTE.Core.Models
@using ProcurementHTE.Core.Authorization
@using System.Linq
@using System.Collections.Generic
@inject IAuthorizationService AuthZ
@model PagedResult<Procurement>

@{
    var canEdit = await AuthZ.AuthorizeAsync(User, Permissions.Procurement.Edit);
    var canDelete = await AuthZ.AuthorizeAsync(User, Permissions.Procurement.Delete);
    var canManage = ProcurementHTE.Web.Authorization.ActionRoles.Allows(User, ProcurementHTE.Web.Authorization.ActionRoles.Procurement);
    var canCancel = ProcurementHTE.Web.Authorization.ActionRoles.Allows(User, ProcurementHTE.Web.Authorization.ActionRoles.Cancel);
    
}

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mobile-table">
        <thead class="table-light text-center">
            <tr class="align-middle">
                <th scope="col" sort-key="spmp" filter-key="spmp" class="border-end">SPMP</th>
                <th scope="col" sort-key="jobName" filter-key="jobName" class="border-end">Job Name</th>
                <th scope="col" sort-key="jobType" filter-key="jobType" class="border-end">Job Type</th>
                <th scope="col" sort-key="region" filter-key="region" class="border-end">Project Region</th>
                <th scope="col" sort-key="startDate" sort-kind="date" class="border-end">Start Date</th>
                <th scope="col" sort-key="vendor" filter-key="vendor" class="border-end">Vendor</th>
                <th scope="col" class="text-center position-sticky end-0 width-10-rem">Aksi</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || !Model.Items.Any()) {
                <tr>
                    <td colspan="7" class="text-center text-muted">Data procurement tidak ditemukan</td>
                </tr>
            } else {
                foreach (var item in Model.Items) {
                    var latestPnl = item.ProfitLosses?
                    .OrderByDescending(p => p.CreatedAt)
                    .FirstOrDefault();
                    var vendorName = latestPnl?.SelectedVendor?.VendorName
                    ?? (!string.IsNullOrWhiteSpace(latestPnl?.SelectedVendorId) ? latestPnl!.SelectedVendorId : null)
                    ?? "-";
                    var region = item.ProjectRegion.ToString();
                    var statusName = item.Status?.StatusName ?? "-";
                    
                    var isPublished = statusName.Equals("Waiting Pickup", StringComparison.OrdinalIgnoreCase) 
                                   || statusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase)
                                   || statusName.Equals("Completed", StringComparison.OrdinalIgnoreCase) 
                                   || statusName.Equals("Closed", StringComparison.OrdinalIgnoreCase)
                                   || statusName.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                    var canCancelThisItem = canCancel
                        && !statusName.Equals("Completed", StringComparison.OrdinalIgnoreCase)
                        && !statusName.Equals("Closed", StringComparison.OrdinalIgnoreCase)
                        && !statusName.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                    var canEditThisItem = canManage && canEdit.Succeeded && !isPublished;
                    var canDeleteThisItem = User.IsInRole("Admin") || (canManage && canDelete.Succeeded && !isPublished);
                    <tr>
                        <td class="d-flex d-sm-table-cell" data-label="SPMP">
                            @(ProcurementHTE.Core.Finance.FinanceTable.ShortSpmp(item.SpmpNumber) ?? "-")
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Job Name">
                            @item.JobName
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Job Type">
                            @(item.JobType?.TypeName ?? "-")
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Project Region">
                            @(!string.IsNullOrWhiteSpace(region) ? region : "-")
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Start Date">
                            @(item.StartDate == default ? "-" : item.StartDate.ToString("dd MMM yyyy"))
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Vendor">
                            @vendorName
                        </td>
                        <td class="text-md-center d-flex d-sm-table-cell position-sticky end-0 width-10-rem" data-label="Action">
                            @if (canEditThisItem) {
                                <a class="btn btn-outline-warning btn-sm mb-sm-2 w-100" asp-action="Edit" asp-route-id="@item.ProcurementId" role="button">
                                    <i class="bi bi-pencil-fill"></i>
                                    <span class="ms-1">Edit</span>
                                </a>
                            }
                            <a class="btn btn-outline-info btn-sm mb-sm-2 w-100" asp-action="Details" asp-route-id="@item.ProcurementId" role="button">
                                <i class="bi bi-eye-fill"></i>
                                <span class="ms-1">Detail</span>
                            </a>
                            @if (canDeleteThisItem) {
                                var deleteTitle = string.IsNullOrWhiteSpace(item.Wonum)
                                ? "Delete procurement?"
                                : $"Delete {item.Wonum}?";
                                var deleteMessage = string.IsNullOrWhiteSpace(item.JobName)
                                ? "Admin can restore it from Deleted Records."
                                : $"You are about to delete \"{item.JobName}\". Admin can restore it from Deleted Records.";
                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline delete-form"
                                      hx-boost="false"
                                      hx-ignore="true"
                                      data-loading-overlay="true"
                                      data-confirm-title="@deleteTitle"
                                      data-confirm-message="@System.Text.Encodings.Web.HtmlEncoder.Default.Encode(deleteMessage)">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProcurementId" />
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm mb-sm-2 w-100">
                                        <i class="bi bi-trash-fill"></i>
                                        <span class="ms-1">Hapus</span>
                                    </button>
                                </form>
                            }
                            @if (canCancelThisItem) {
                                <form asp-action="Cancel"
                                      method="post"
                                      class="d-inline delete-form"
                                      hx-boost="false"
                                      hx-ignore="true"
                                      data-loading-overlay="true"
                                      data-confirm-title="Batalkan pekerjaan ini?"
                                      data-confirm-message="Pekerjaan akan berhenti diproses, tetapi tetap tercatat di LDP dengan keterangan Cancel.">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProcurementId" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm mb-sm-2 w-100">
                                        <i class="bi bi-x-circle"></i>
                                        <span class="ms-1">Batal</span>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
