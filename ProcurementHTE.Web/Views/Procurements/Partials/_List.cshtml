@using Microsoft.AspNetCore.Authorization
@using ProcurementHTE.Core.Common
@using ProcurementHTE.Core.Models
@using ProcurementHTE.Core.Authorization
@using System.Linq
@using System.Collections.Generic
@inject IAuthorizationService AuthZ
@model PagedResult<Procurement>

@{
    var canEdit = await AuthZ.AuthorizeAsync(User, Permissions.Procurement.Edit);
    var canDelete = await AuthZ.AuthorizeAsync(User, Permissions.Procurement.Delete);
    var canManage = ProcurementHTE.Web.Authorization.ActionRoles.Allows(User, ProcurementHTE.Web.Authorization.ActionRoles.Procurement);
    var canCancel = ProcurementHTE.Web.Authorization.ActionRoles.Allows(User, ProcurementHTE.Web.Authorization.ActionRoles.Cancel);
    var isAdmin = User.IsInRole("Admin");
    // Every action the user can take on some job keeps its place in every row, dimmed with the
    // reason where it does not apply, so the icons line up from row to row.
    var showEdit = canManage && canEdit.Succeeded;
    var showDelete = isAdmin || (canManage && canDelete.Succeeded);
    
}

<div class="table-responsive border rounded-3">
    <table class="table table-aligned table-hover align-middle mobile-table">
        <thead class="table-light text-center">
            <tr class="align-middle">
                <th scope="col" sort-key="spmp" filter-key="spmp" class="border-end">SPMP</th>
                <th scope="col" sort-key="jobName" filter-key="jobName" class="border-end">Job Name</th>
                <th scope="col" sort-key="jobType" filter-key="jobType" class="border-end">Job Type</th>
                <th scope="col" sort-key="contractType" filter-key="contractType" class="border-end">Contract Type</th>
                <th scope="col" sort-key="region" filter-key="region" class="border-end">Project Region</th>
                <th scope="col" sort-key="startDate" filter-key="startDate" sort-kind="date" class="border-end">Start Date</th>
                <th scope="col" sort-key="vendor" filter-key="vendor" class="border-end">Vendor</th>
                <th scope="col" class="text-center">Aksi</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || !Model.Items.Any()) {
                <tr>
                    <td colspan="8" class="text-center text-muted">Data procurement tidak ditemukan</td>
                </tr>
            } else {
                foreach (var item in Model.Items) {
                    var latestPnl = item.ProfitLosses?
                    .OrderByDescending(p => p.CreatedAt)
                    .FirstOrDefault();
                    var vendorName = latestPnl?.SelectedVendor?.VendorName
                    ?? (!string.IsNullOrWhiteSpace(latestPnl?.SelectedVendorId) ? latestPnl!.SelectedVendorId : null)
                    ?? "-";
                    var region = item.ProjectRegion.ToString();
                    var statusName = item.Status?.StatusName ?? "-";
                    
                    var isPublished = statusName.Equals("Waiting Pickup", StringComparison.OrdinalIgnoreCase) 
                                   || statusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase)
                                   || statusName.Equals("Completed", StringComparison.OrdinalIgnoreCase) 
                                   || statusName.Equals("Closed", StringComparison.OrdinalIgnoreCase)
                                   || statusName.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                    var canCancelThisItem = canCancel
                        && !statusName.Equals("Completed", StringComparison.OrdinalIgnoreCase)
                        && !statusName.Equals("Closed", StringComparison.OrdinalIgnoreCase)
                        && !statusName.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
                    var canEditThisItem = canManage && canEdit.Succeeded && ProcurementHTE.Core.Services.ProcurementService.CanEdit(item, isAdmin);
                    var canDeleteThisItem = isAdmin || (canManage && canDelete.Succeeded && !isPublished);
                    <tr>
                        <td class="d-flex d-sm-table-cell" data-label="SPMP">
                            @(ProcurementHTE.Core.Finance.FinanceTable.ShortSpmp(item.SpmpNumber) ?? "-")
                        </td>
                        <td class="d-flex d-sm-table-cell text-start" data-label="Job Name">
                            <a asp-action="Details" asp-route-id="@item.ProcurementId" class="fw-semibold text-decoration-none">@item.JobName</a>
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Job Type">
                            @(item.JobType?.TypeName ?? "-")
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Contract Type">
                            @(item.ContractType == ProcurementHTE.Core.Enums.ContractType.None ? "-" : item.ContractType.ToString())
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Project Region">
                            @(!string.IsNullOrWhiteSpace(region) ? region : "-")
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Start Date">
                            @(item.StartDate == default ? "-" : item.StartDate.ToString("dd MMM yyyy"))
                        </td>
                        <td class="d-flex d-sm-table-cell" data-label="Vendor">
                            @vendorName
                        </td>
                        <td class="text-center d-flex d-sm-table-cell" data-label="Aksi">
                            @{
                                var isCancelled = statusName.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
                                    || item.ProcurementStatus == ProcurementHTE.Core.Enums.ProcurementStatus.Cancelled;
                                var editBlocked = isCancelled ? "Pekerjaan yang dibatalkan tidak bisa diedit" : "Pekerjaan yang sudah di-publish hanya bisa diedit Admin";
                                var cancelBlocked = "Pekerjaan sudah selesai atau dibatalkan";
                                var deleteBlocked = "Pekerjaan yang sudah di-publish hanya bisa dihapus Admin";
                            }
                            <div class="row-actions">
                                <a class="btn btn-row" asp-action="Details" asp-route-id="@item.ProcurementId" aria-label="Detail" title="Detail">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                                @if (canEditThisItem) {
                                    <a class="btn btn-row" asp-action="Edit" asp-route-id="@item.ProcurementId" aria-label="Edit" title="Edit">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                } else if (showEdit) {
                                    <span class="d-inline-flex" title="@editBlocked">
                                        <button type="button" class="btn btn-row" disabled aria-label="@($"Edit tidak tersedia: {editBlocked}")">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                }
                                @if (canCancelThisItem) {
                                    <form asp-action="Cancel"
                                          method="post"
                                          class="delete-form"
                                          hx-boost="false"
                                          hx-ignore="true"
                                          data-loading-overlay="true"
                                          data-confirm-title="Batalkan pekerjaan ini?"
                                          data-confirm-message="Pekerjaan akan berhenti diproses, tetapi tetap tercatat di LDP dengan keterangan Cancel."
                                          data-confirm-confirm="Batalkan pekerjaan"
                                          data-confirm-cancel="Kembali">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ProcurementId" />
                                        <button type="submit" class="btn btn-row btn-row--warning" aria-label="Batalkan pekerjaan" title="Batalkan pekerjaan">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                } else if (canCancel) {
                                    <span class="d-inline-flex" title="@cancelBlocked">
                                        <button type="button" class="btn btn-row" disabled aria-label="@($"Batalkan tidak tersedia: {cancelBlocked}")">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                }
                                @if (canDeleteThisItem) {
                                    <form asp-action="Delete"
                                          method="post"
                                          class="delete-form"
                                          hx-boost="false"
                                          hx-ignore="true"
                                          data-loading-overlay="true"
                                          data-confirm-title="@($"Hapus {item.DisplayId}?")"
                                          data-confirm-message="@($"\"{item.JobName}\" akan dihapus. Admin bisa memulihkannya dari menu Data Terhapus.")"
                                          data-confirm-confirm="Hapus">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ProcurementId" />
                                        <button type="submit" class="btn btn-row btn-row--danger" aria-label="Hapus" title="Hapus">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                } else if (showDelete) {
                                    <span class="d-inline-flex" title="@deleteBlocked">
                                        <button type="button" class="btn btn-row" disabled aria-label="@($"Hapus tidak tersedia: {deleteBlocked}")">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
