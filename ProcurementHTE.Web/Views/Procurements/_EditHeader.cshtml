@model ProcurementHTE.Web.Models.ViewModels.ProcurementEditViewModel
@{
    var jobTypeName = ViewBag.SelectedJobTypeName as string ?? "Other";
}

<header class="hstack justify-content-between mb-3">
    <div>
        <h1 class="h2 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">
            SPMP: <span class="fw-semibold">@(ProcurementHTE.Core.Finance.FinanceTable.ShortSpmp(Model.SpmpNumber) ?? "-")</span>
            <span class="mx-2 text-secondary">|</span>
            Type: <span class="fw-semibold">@jobTypeName</span>
        </p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ProcurementId" role="button">
        <i class="bi bi-arrow-left"></i> Kembali ke daftar
    </a>
</header>
