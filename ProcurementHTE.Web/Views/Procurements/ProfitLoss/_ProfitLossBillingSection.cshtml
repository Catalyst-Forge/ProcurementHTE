@model ProcurementHTE.Web.Models.ViewModels.ProfitLossInputViewModel
@{
    var jobTypeName = Model.JobTypeName ?? ViewBag.JobTypeName ?? "Angkutan";
    var isPengangkutan = jobTypeName == "Angkutan";
    var isSewaUnit = jobTypeName == "StandBy";
    var isMoving = jobTypeName == "Moving";
}

<section class="col-12" aria-labelledby="pdc-section-title">
    <div class="card shadow-sm">
        <fieldset class="card-body">
            <legend class="card-title fw-semibold" id="pdc-section-title">Billing to PDC</legend>
            <hr />
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="min-width:220px">Item Penawaran</th>
                            <th scope="col" class="text-end" style="width:100px">Qty Items</th>
                            <th scope="col" class="text-end" style="width:100px">Unit Items</th>
                            <th scope="col" class="text-end" style="width:140px">Jarak</th>
                            @if (!isPengangkutan)
                            {
                                <th scope="col" class="text-end" style="width:160px">Quantity/Durasi</th>
                                <th scope="col" class="text-end" style="width:120px">Unit Revenue</th>
                            }
                            <th scope="col" class="text-end" style="width:220px">Revenue</th>
                        </tr>
                    </thead>
                    <partial name="~/Views/Procurements/ProfitLoss/_ProfitLossBillingRows.cshtml" />
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="@(isPengangkutan ? 4 : 6)" class="text-end fw-bold">TOTAL</th>
                            <th class="text-end">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text fw-bold">Rp</span>
                                    <input id="revenue" class="form-control form-control-sm text-end fw-bold" readonly />
                                </div>
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </fieldset>
    </div>
</section>
