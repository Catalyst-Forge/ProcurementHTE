@model AccountSettingsPageViewModel
@{
    var enabled = Model.Settings.TwoFactor.IsEnabled;
}

<div class="card settings-card h-100">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h5 class="mb-0">Verifikasi 2 Langkah (2FA)</h5>
            <small class="text-muted">
                @(enabled
                    ? $"Aktif · {AccountDisplayText.ForTwoFactorMethod(Model.Settings.Overview.TwoFactorMethod)}"
                    : "Tambahkan kode kedua saat login untuk melindungi akun.")
            </small>
        </div>
        <span class="badge rounded-pill @(enabled ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
            <i class="bi @(enabled ? "bi-shield-check" : "bi-shield-exclamation")" aria-hidden="true"></i>
            @(enabled ? "Aktif" : "Belum aktif")
        </span>
    </div>
    <div class="card-body d-flex flex-column">
        @if (!enabled)
        {
            @await Html.PartialAsync("_SettingsTwoFactorDisabled", Model)
        }
        else
        {
            @await Html.PartialAsync("_SettingsTwoFactorEnabled", Model)

            <form asp-action="DisableTwoFactor" method="post" class="delete-form mt-auto pt-3 border-top"
                  data-confirm-title="Nonaktifkan 2FA?"
                  data-confirm-message="Login berikutnya cukup memakai password. Akun Anda jadi lebih mudah dibobol."
                  data-confirm-confirm="Ya, nonaktifkan"
                  data-confirm-cancel="Batal">
                <button type="submit" class="btn btn-link text-danger px-0">
                    <i class="bi bi-shield-x" aria-hidden="true"></i> Nonaktifkan 2FA
                </button>
            </form>
        }
    </div>
</div>
