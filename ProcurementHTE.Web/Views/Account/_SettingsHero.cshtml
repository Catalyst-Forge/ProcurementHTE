@model AccountSettingsPageViewModel
@{
    const int visibleRoleCount = 3;
    var overview = Model.Settings.Overview;
    var roles = overview.Roles ?? Array.Empty<string>();
    var shownRoles = roles.Take(visibleRoleCount).ToList();
    var hiddenRoles = roles.Skip(visibleRoleCount).ToList();
    var hasCustomAvatar = overview.AvatarUrl != null;
}

<section class="card settings-card account-summary mb-4" aria-label="Ringkasan akun">
    <div class="card-body d-flex flex-column flex-md-row gap-4 align-items-md-center">
        <div class="account-avatar">
            <img src="@Model.AvatarUrl" class="rounded-circle" alt="Foto profil @Model.FullName" id="currentAvatar" width="88" height="88" />
            <label for="avatarFile" class="account-avatar-edit" title="Ganti foto profil">
                <i class="bi bi-camera" aria-hidden="true"></i>
                <span class="visually-hidden">Ganti foto profil</span>
            </label>
        </div>

        <div class="flex-grow-1 min-w-0">
            <h3 class="h4 mb-1 text-break">@Model.FullName</h3>
            <p class="text-muted mb-2 text-break">@Model.JobTitle &middot; @overview.Email</p>

            @if (roles.Count > 0)
            {
                <ul class="account-roles list-unstyled d-flex flex-wrap gap-2 mb-0" aria-label="Role">
                    @foreach (var role in shownRoles)
                    {
                        <li class="account-chip">@role</li>
                    }
                    @if (hiddenRoles.Count > 0)
                    {
                        <li class="account-chip account-chip--more" title="@string.Join(", ", hiddenRoles)">
                            +@hiddenRoles.Count role lainnya
                            <span class="visually-hidden">: @string.Join(", ", hiddenRoles)</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="account-summary-side d-flex flex-column gap-3 align-items-md-end">
            <dl class="account-meta mb-0">
                <div>
                    <dt>Login terakhir</dt>
                    <dd>@Model.LastLogin</dd>
                </div>
                <div>
                    <dt>Akun dibuat</dt>
                    <dd>@overview.CreatedAt.ToString("dd MMM yyyy")</dd>
                </div>
            </dl>
            <div class="d-flex gap-2">
                <label for="avatarFile" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-camera" aria-hidden="true"></i><span>Ganti foto</span>
                </label>
                @if (hasCustomAvatar)
                {
                    <form asp-action="RemoveAvatar" method="post" class="delete-form"
                          data-confirm-title="Hapus foto profil?"
                          data-confirm-message="Foto akan diganti dengan avatar bawaan."
                          data-confirm-confirm="Hapus foto"
                          data-confirm-cancel="Batal">
                        <button type="submit" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-trash" aria-hidden="true"></i><span>Hapus</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
