@model AccountSettingsViewModel
@{
    const int initiallyShown = 5;
    var ordered = Model.Sessions
        .OrderByDescending(s => s.IsCurrent)
        .ThenByDescending(s => s.IsActive)
        .ThenByDescending(s => s.CreatedAt)
        .ToList();
    var activeCount = ordered.Count(s => s.IsActive);
    var otherActiveCount = ordered.Count(s => s.IsActive && !s.IsCurrent);
    var firstRows = ordered.Take(initiallyShown).ToList();
    var moreRows = ordered.Skip(initiallyShown).ToList();
}

<section class="card settings-card mb-4" id="perangkat" aria-labelledby="perangkat-title">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h5 class="mb-0" id="perangkat-title">Perangkat &amp; Sesi</h5>
            <small class="text-muted">@activeCount sesi aktif. Akhiri sesi yang tidak Anda kenali.</small>
        </div>
        @if (otherActiveCount > 0)
        {
            <form asp-action="LogoutAllSessions" method="post" class="delete-form"
                  data-confirm-title="Logout dari semua perangkat?"
                  data-confirm-message="Semua sesi aktif akan diakhiri, termasuk perangkat ini. Anda perlu login ulang."
                  data-confirm-confirm="Logout semua"
                  data-confirm-cancel="Batal">
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Logout semua perangkat</button>
            </form>
        }
    </div>

    @if (!ordered.Any())
    {
        <div class="card-body"><p class="text-muted mb-0">Belum ada data sesi.</p></div>
    }
    else
    {
        <ul class="session-list list-unstyled mb-0">
            @foreach (var session in firstRows)
            {
                @await Html.PartialAsync("_SettingsSessionRow", session)
            }
        </ul>
        @if (moreRows.Count > 0)
        {
            <details class="session-more">
                <summary>Tampilkan @moreRows.Count sesi lainnya</summary>
                <ul class="session-list list-unstyled mb-0">
                    @foreach (var session in moreRows)
                    {
                        @await Html.PartialAsync("_SettingsSessionRow", session)
                    }
                </ul>
            </details>
        }
    }
</section>

