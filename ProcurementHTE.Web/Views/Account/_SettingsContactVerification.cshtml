@model AccountSettingsPageViewModel

<section class="card settings-card mb-4" id="kontak" aria-labelledby="kontak-title">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h5 class="mb-0" id="kontak-title">Verifikasi Kontak</h5>
            <small class="text-muted">Kontak terverifikasi dipakai untuk reset password dan kode 2FA.</small>
        </div>
        <span class="badge rounded-pill @(Model.ContactVerificationComplete ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
            <i class="bi @(Model.ContactVerificationComplete ? "bi-check-circle" : "bi-exclamation-circle")" aria-hidden="true"></i>
            @(Model.ContactVerificationComplete ? "Semua terverifikasi" : "Perlu verifikasi")
        </span>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                @await Html.PartialAsync("_SettingsEmailVerification", Model)
            </div>
            <div class="col-md-6">
                @await Html.PartialAsync("_SettingsPhoneVerification", Model)
            </div>
        </div>
    </div>
</section>
