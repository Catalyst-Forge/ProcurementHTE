@model AccountSettingsPageViewModel

@if (Model.RequireEmailVerificationForTwoFactor)
{
    <div class="alert alert-warning small">
        Email @Model.Settings.Overview.Email belum terverifikasi sehingga 2FA via email tidak bisa dipakai.
        <form asp-action="SendEmailVerification" method="post" class="mt-2">
            <button type="submit" class="btn btn-sm btn-outline-primary" data-cooldown-button data-label="Kirim tautan verifikasi" data-cooldown-seconds="@Model.EmailVerificationCooldown" data-status-target="#emailVerificationStatus">
                Kirim tautan verifikasi
            </button>
        </form>
    </div>
}
@if (Model.RequirePhoneVerificationForTwoFactor)
{
    <div class="alert alert-warning small">
        Nomor HP belum terverifikasi sehingga 2FA via SMS tidak bisa dipakai. Verifikasi dulu di bagian <a href="#kontak">Kontak</a>.
        @if (!string.IsNullOrWhiteSpace(Model.Settings.Overview.PhoneNumber))
        {
            <form asp-action="SendPhoneVerification" method="post" class="mt-2">
                <button type="submit" class="btn btn-sm btn-outline-primary" data-cooldown-button data-label="Kirim kode OTP" data-cooldown-seconds="@Model.PhoneVerificationCooldown" data-status-target="#phoneVerificationStatus">
                    Kirim kode OTP
                </button>
            </form>
        }
    </div>
}

<div class="recovery-summary">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="me-auto">
            <div class="fw-semibold">Recovery codes</div>
            <small class="text-muted">Dipakai untuk masuk kalau HP atau aplikasi authenticator hilang.</small>
        </div>
        @if (Model.HasStoredRecoveryCodes)
        {
            <span class="badge rounded-pill bg-body-secondary text-body">@Model.Settings.TwoFactor.RecoveryCodesLeft tersisa</span>
            <form asp-action="GenerateRecoveryCodes" method="post" class="delete-form"
                  data-confirm-title="Buat recovery codes baru?"
                  data-confirm-message="Semua recovery code lama langsung tidak berlaku lagi."
                  data-confirm-confirm="Buat ulang"
                  data-confirm-cancel="Batal">
                <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Buat ulang</button>
            </form>
        }
    </div>

    @await Html.PartialAsync("_SettingsRecoveryCodes", Model)
</div>
