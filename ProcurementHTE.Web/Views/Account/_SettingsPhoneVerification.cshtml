@model AccountSettingsPageViewModel
@{
    var overview = Model.Settings.Overview;
    var hasPhone = !string.IsNullOrWhiteSpace(overview.PhoneNumber);
    var (statusText, statusClass) = overview.PhoneNumberConfirmed
        ? ("Terverifikasi", "bg-success-subtle text-success-emphasis")
        : !Model.SmsVerificationAvailable
            ? ("Belum tersedia", "bg-secondary-subtle text-secondary-emphasis")
            : ("Belum diverifikasi", "bg-warning-subtle text-warning-emphasis");
}

<div class="contact-tile">
    <div class="contact-tile-head">
        <span class="contact-tile-icon" aria-hidden="true"><i class="bi bi-phone"></i></span>
        <div class="min-w-0">
            <p class="contact-tile-label">Nomor HP</p>
            <p class="contact-tile-value @(hasPhone ? string.Empty : "text-muted fw-normal")">@(hasPhone ? overview.PhoneNumber : "Belum diisi")</p>
        </div>
        <span class="badge rounded-pill ms-auto @statusClass">@statusText</span>
    </div>

    @if (!Model.SmsVerificationAvailable)
    {
        <p class="small text-muted mt-3 mb-0">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            Verifikasi nomor HP aktif setelah gateway SMS/WhatsApp dikonfigurasi.
        </p>
    }
    else if (!hasPhone)
    {
        <p class="small text-muted mt-3 mb-0">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            Isi nomor HP di bagian <a href="#profil">Profil</a> lalu kembali ke sini untuk verifikasi.
        </p>
    }
    else if (!overview.PhoneNumberConfirmed)
    {
        <form asp-action="SendPhoneVerification" method="post" class="mt-3">
            <button type="submit" class="btn btn-outline-primary w-100" data-cooldown-button data-label="Kirim kode OTP" data-cooldown-seconds="@Model.PhoneVerificationCooldown" data-status-target="#phoneVerificationStatus">
                <i class="bi bi-chat-dots" aria-hidden="true"></i> Kirim kode OTP
            </button>
        </form>
        <div class="small text-muted mt-2" id="phoneVerificationStatus" aria-live="polite"></div>
        <form asp-action="VerifyPhone" method="post" class="mt-2 d-flex flex-column gap-3">
            <input type="hidden" name="code" data-otp-hidden="settings.phone" />
            <fieldset class="border-0 p-0 m-0">
                <legend class="form-label small mb-2">Masukkan 6 digit kode OTP</legend>
                <div class="d-flex gap-2 otp-input-wrapper" data-otp-container="settings.phone">
                    @for (var i = 0; i < 6; i++)
                    {
                        <input type="text" inputmode="numeric" maxlength="1" class="form-control text-center otp-input" aria-label="Digit @(i + 1)" data-otp-input />
                    }
                </div>
            </fieldset>
            <button type="submit" class="btn btn-primary w-100">Verifikasi nomor</button>
        </form>
        @if (Model.ShowPhoneVerify)
        {
            <div class="alert alert-warning mt-2 mb-0 small">Masukkan kode OTP yang baru dikirim ke nomor Anda.</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.DevPhoneOtp))
        {
            <div class="alert alert-info mt-2 mb-0 small">Dev OTP: <strong>@Model.DevPhoneOtp</strong></div>
        }
    }
</div>
