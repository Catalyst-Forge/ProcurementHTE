@model AccountSettingsPageViewModel

@if (Model.Settings.TwoFactor.NewlyGeneratedRecoveryCodes?.Any() == true && !Model.RecoveryCodesHidden)
{
    <div class="recovery-codes mt-3">
        <p class="small mb-2">Simpan kode ini di tempat aman. Setiap kode hanya bisa dipakai sekali.</p>
        <ul class="recovery-code-grid list-unstyled mb-3">
            @foreach (var code in Model.Settings.TwoFactor.NewlyGeneratedRecoveryCodes)
            {
                <li><code>@code</code></li>
            }
        </ul>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="DownloadRecoveryCodes" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener"><i class="bi bi-download" aria-hidden="true"></i> Unduh .txt</a>
            <form asp-action="HideRecoveryCodes" method="post">
                <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye-slash" aria-hidden="true"></i> Sembunyikan</button>
            </form>
        </div>
    </div>
}
else if (Model.RecoveryCodesHidden && Model.HasStoredRecoveryCodes)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
        <small class="text-muted me-auto">Kode disembunyikan. Tampilkan atau unduh kapan saja.</small>
        <a asp-action="DownloadRecoveryCodes" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener"><i class="bi bi-download" aria-hidden="true"></i> Unduh</a>
        <form asp-action="ShowRecoveryCodes" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-eye" aria-hidden="true"></i> Tampilkan</button>
        </form>
    </div>
}
else if (!Model.HasStoredRecoveryCodes)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 mt-3 mb-0 small">
        <span class="me-auto">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            Anda belum punya recovery code. Buat sekarang supaya tidak terkunci kalau perangkat hilang.
        </span>
        <form asp-action="GenerateRecoveryCodes" method="post">
            <button type="submit" class="btn btn-warning btn-sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> Buat recovery codes</button>
        </form>
    </div>
}
