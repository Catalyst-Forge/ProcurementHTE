@model AccountSettingsPageViewModel
@{
    var confirmed = Model.Settings.Overview.EmailConfirmed;
}

<div class="contact-tile">
    <div class="contact-tile-head">
        <span class="contact-tile-icon" aria-hidden="true"><i class="bi bi-envelope"></i></span>
        <div class="min-w-0">
            <p class="contact-tile-label">Email</p>
            <p class="contact-tile-value text-break">@Model.Settings.Overview.Email</p>
        </div>
        <span class="badge rounded-pill ms-auto @(confirmed ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
            @(confirmed ? "Terverifikasi" : "Belum diverifikasi")
        </span>
    </div>

    @if (!confirmed)
    {
        <p class="small text-muted mt-3 mb-2">Kami kirim tautan verifikasi ke email ini. Buka tautannya dari perangkat mana saja.</p>
        <form asp-action="SendEmailVerification" method="post">
            <button type="submit" class="btn btn-outline-primary w-100" data-cooldown-button data-label="Kirim tautan verifikasi" data-cooldown-seconds="@Model.EmailVerificationCooldown" data-status-target="#emailVerificationStatus">
                <i class="bi bi-link-45deg" aria-hidden="true"></i> Kirim tautan verifikasi
            </button>
        </form>
        <div class="small text-muted mt-2" id="emailVerificationStatus" aria-live="polite"></div>
        @if (!string.IsNullOrWhiteSpace(Model.DevMagicLink))
        {
            <div class="alert alert-info mt-2 mb-0 small">
                Dev magic link: <a href="@Model.DevMagicLink">@Model.DevMagicLink</a>
            </div>
        }
    }
</div>
