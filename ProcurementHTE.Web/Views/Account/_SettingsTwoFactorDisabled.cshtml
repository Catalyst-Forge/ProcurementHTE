@using ProcurementHTE.Core.Enums
@model AccountSettingsPageViewModel
@{
    var smsReady = Model.SmsVerificationAvailable && Model.Settings.Overview.PhoneNumberConfirmed;
}

<form asp-action="EnableTwoFactor" method="post" id="twoFactorEnableForm" class="d-flex flex-column gap-3">
    <fieldset class="border-0 p-0 m-0">
        <legend class="form-label fw-semibold">1. Pilih metode</legend>
        <div class="list-group">
            <label class="list-group-item d-flex align-items-start gap-2">
                <input class="form-check-input mt-1" type="radio" name="method" value="@TwoFactorMethod.AuthenticatorApp" checked />
                <span><span class="fw-semibold d-block">Aplikasi authenticator</span><small class="text-muted">Google Authenticator, Microsoft Authenticator, dan sejenisnya. Paling aman.</small></span>
            </label>
            <label class="list-group-item d-flex align-items-start gap-2">
                <input class="form-check-input mt-1" type="radio" name="method" value="@TwoFactorMethod.Email" />
                <span><span class="fw-semibold d-block">Kode via email</span><small class="text-muted">Dikirim ke @Model.Settings.Overview.Email.</small></span>
            </label>
            <label class="list-group-item d-flex align-items-start gap-2 @(smsReady ? string.Empty : "text-muted")">
                <input class="form-check-input mt-1" type="radio" name="method" value="@TwoFactorMethod.Sms" @(smsReady ? string.Empty : "disabled") />
                <span>
                    <span class="fw-semibold d-block">Kode via SMS</span>
                    <small class="text-muted">@(Model.SmsVerificationAvailable ? "Butuh nomor HP yang sudah terverifikasi." : "Belum tersedia sampai gateway SMS/WhatsApp dikonfigurasi.")</small>
                </span>
            </label>
        </div>
    </fieldset>

    <div class="authenticator-setup" id="authenticatorInfo">
        <p class="form-label fw-semibold mb-2">2. Hubungkan aplikasi</p>
        <div class="d-flex flex-wrap align-items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.Settings.TwoFactor.AuthenticatorQrBase64))
            {
                <img src="data:image/png;base64,@Model.Settings.TwoFactor.AuthenticatorQrBase64" alt="QR code untuk aplikasi authenticator" class="authenticator-qr" width="148" height="148" />
            }
            <div class="min-w-0">
                <p class="small text-muted mb-1">Scan QR, atau ketik kode rahasia ini di aplikasi:</p>
                <code class="authenticator-key">@Model.Settings.TwoFactor.SharedKey</code>
            </div>
        </div>
    </div>

    <div>
        <label class="form-label fw-semibold" for="twoFactorVerificationCode">3. Masukkan kode verifikasi</label>
        <div class="input-group">
            <input type="text" id="twoFactorVerificationCode" name="verificationCode" class="form-control" placeholder="6 digit kode" required maxlength="8" inputmode="numeric" autocomplete="one-time-code" aria-describedby="twoFactorCodeHelp" />
            <button type="button" class="btn btn-outline-secondary d-none" id="btnSendSetupCode">Kirim kode</button>
        </div>
        <small class="text-muted" id="twoFactorCodeHelp">Masukkan kode dari aplikasi authenticator.</small>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary"><i class="bi bi-shield-lock" aria-hidden="true"></i> Aktifkan 2FA</button>
    </div>
</form>
