@using ProcurementHTE.Core.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<DocumentApprovalRule>
@{
    ViewData["Title"] = "Document Approval Rules";
    var docTypes = ViewBag.DocumentTypes as List<DocumentType> ?? new();
    var roleMap = ViewBag.RoleMap as IDictionary<string, string> ?? new Dictionary<string, string>();
    var userMap = ViewBag.UserMap as IDictionary<string, string> ?? new Dictionary<string, string>();
    var inProgress = ViewBag.InProgressUsage as ProcurementHTE.Core.Models.DTOs.InProgressProcurementUsage
        ?? ProcurementHTE.Core.Models.DTOs.InProgressProcurementUsage.Empty;
    var selectedDocType = Context.Request.Query["documentTypeId"].ToString();
    var docSelect = new SelectList(docTypes, "DocumentTypeId", "Name", selectedDocType);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Document Approval Rules</h1>
        <p class="text-muted mb-0">Atur role diajukan/disetujui berdasarkan nilai PNL per dokumen.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Rule Baru
        </a>
    </div>
</div>

<form method="get" class="border rounded-3 p-3 mb-3 d-flex flex-wrap gap-2 align-items-center">
    <div class="w-auto">
        <label for="filterDocumentType" class="form-label small text-muted mb-1">Filter Dokumen</label>
        <select id="filterDocumentType" class="form-select" name="documentTypeId" data-auto-submit
                asp-items="docSelect">
            <option value="">Semua Dokumen</option>
        </select>
    </div>
    <div class="ms-auto">
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-clockwise"></i> Muat ulang
        </button>
    </div>
</form>

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mobile-table">
        <thead class="table-light">
            <tr>
                <th scope="col">Document</th>
                <th scope="col">Job Type</th>
                <th scope="col">Category</th>
                <th scope="col" class="text-end">Min Amount</th>
                <th scope="col" class="text-end">Max Amount</th>
                <th scope="col">Submitter</th>
                <th scope="col">Approver</th>
                <th scope="col" class="text-center">Seq</th>
                <th scope="col" class="text-center">Aktif</th>
                <th scope="col" class="text-center">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">Belum ada approval rule.</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    var jobTypeLabel = string.IsNullOrWhiteSpace(item.JobType?.TypeName)
                        ? "Semua"
                        : item.JobType!.TypeName;
                    var categoryLabel = item.ProcurementCategory.HasValue
                        ? item.ProcurementCategory.ToString()
                        : "Semua";
                    var submitterLabel = roleMap.TryGetValue(item.SubmitterRoleId, out var sName)
                        ? sName
                        : item.SubmitterRoleId;
                    var submitterUserLabel = !string.IsNullOrWhiteSpace(item.SubmitterUserId) && userMap.TryGetValue(item.SubmitterUserId, out var suName)
                        ? suName
                        : null;
                    <tr>
                        <td>@item.DocumentType?.Name</td>
                        <td>@jobTypeLabel</td>
                        <td>@categoryLabel</td>
                        <td class="text-end">@(item.MinAmount.ToString("N0"))</td>
                        <td class="text-end">@(item.MaxAmount == decimal.MaxValue ? "Tanpa batas" : item.MaxAmount.ToString("N0"))</td>
                        <td>
                            @submitterLabel
                            @if (!string.IsNullOrWhiteSpace(submitterUserLabel))
                            {
                                <br /><small class="text-muted">@submitterUserLabel</small>
                            }
                        </td>
                        <td>
                            @{
                                string approverLabel = "-";
                                string? approverUserLabel = null;
                                if (!string.IsNullOrWhiteSpace(item.ApproverRoleId))
                                {
                                    approverLabel = roleMap.TryGetValue(item.ApproverRoleId, out var aName)
                                        ? aName
                                        : item.ApproverRoleId;
                                }
                                if (!string.IsNullOrWhiteSpace(item.ApproverUserId) && userMap.TryGetValue(item.ApproverUserId, out var auName))
                                {
                                    approverUserLabel = auName;
                                }
                            }
                            @approverLabel
                            @if (!string.IsNullOrWhiteSpace(approverUserLabel))
                            {
                                <br /><small class="text-muted">@approverUserLabel</small>
                            }
                        </td>
                        <td class="text-center">@item.Sequence</td>
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success-subtle text-success-emphasis border border-success-subtle" : "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle")">
                                @(item.IsActive ? "Ya" : "Tidak")
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="row-actions">
                                <a aria-label="Edit" title="Edit" asp-action="Edit" asp-route-id="@item.DocumentApprovalRuleId" class="btn btn-row">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                @{
                                    // A rule without a procurement type applies to every type.
                                    var running = inProgress.Count(item.JobTypeId, item.ProcurementCategory);
                                    var ruleDeleteMessage = "Admin bisa memulihkannya dari menu Data Terhapus."
                                        + (running > 0
                                            ? $" Perhatian: aturan ini berlaku untuk tipe dan kategori yang dipakai {running} procurement yang sedang berjalan. Dokumen yang dibuat setelah ini memakai aturan yang tersisa."
                                            : string.Empty);
                                }
                                <form asp-action="Delete" method="post" class="d-inline delete-form"
                                      data-confirm-title="Hapus rule ini?"
                                      data-confirm-message="@ruleDeleteMessage"
                                      data-confirm-confirm="Hapus"
                                      data-confirm-cancel="Batal">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.DocumentApprovalRuleId" />
                                    <button type="submit" class="btn btn-row btn-row--danger" aria-label="Hapus rule" title="Hapus rule">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

