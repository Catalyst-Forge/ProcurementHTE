@model ProcurementHTE.Web.Models.ViewModels.ProcurementDocumentRowViewModel

@{
    var item = Model.Item;
}

<div class="d-flex gap-2 justify-content-end flex-wrap">
    @if (!item.Uploaded && item.IsUploadRequired && !item.IsGenerated)
    {
        @await Html.PartialAsync("Partials/_ProcurementDocumentUploadForm", Model)
    }

    @if (item.IsGenerated)
    {
        @await Html.PartialAsync("Partials/_ProcurementDocumentGenerateForm", Model)
        @* Any generated document can be swapped for the user's own file, before or after generating. *@
        @await Html.PartialAsync("Partials/_ProcurementDocumentUploadForm", Model, new ViewDataDictionary(ViewData) { ["UploadTitle"] = "Atau upload file sendiri (PDF)" })
    }

    @if (Model.IsUploaded && !string.IsNullOrEmpty(item.ProcDocumentId))
    {
        @await Html.PartialAsync("Partials/_ProcurementDocumentFileActions", Model)
    }

    @if (Model.IsPending && !string.IsNullOrEmpty(item.ProcDocumentId))
    {
        @await Html.PartialAsync("Partials/_ProcurementDocumentPendingActions", Model)
    }
</div>
