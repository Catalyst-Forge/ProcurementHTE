@using ProcurementHTE.Core.Common
@using ProcurementHTE.Core.Models
@model PagedResult<DocumentType>
@{
    ViewData["Title"] = "Document Type Data";
    ViewData["DisableHxBoost"] = true;
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentFields = (Context.Request.Query["fields"].ToString() ?? "Name,Description")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var columns = new (string Key, string Label)[] {
        ("Name","Name"),
        ("Description","Description"),
        ("Status","Status"),
    };
    var pageSize = Model.PageSize;
}

<header class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Documents Types</h1>
    <a asp-action="Create" class="btn btn-outline-primary" role="button"><i class="bi bi-plus-circle"></i> Tambah</a>
</header>

<form method="get" id="filterForm" class="border rounded-3 d-flex flex-wrap gap-2 p-2 mb-2">
    <button type="button" class="btn btn-outline-secondary" id="btnRefresh"><i class="bi bi-arrow-clockwise"></i> Muat ulang</button>

    <div class="input-group w-auto">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input aria-label="Cari" class="form-control" type="search" name="search" id="searchBox" placeholder="Ketik untuk mencari..." value="@currentSearch" />
    </div>

    <div class="dropdown ms-sm-auto">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-funnel"></i> Filter
        </button>

        <div class="dropdown-menu p-3">
            <div class="mb-2 fw-semibold small text-muted">Cari di kolom</div>

            @foreach (var col in columns) {
                var checkedAttr = currentFields.Contains(col.Key) ? "Checked" : null;
                <div class="form-check">
                    <input type="checkbox" class="form-check-input filter-col" value="@col.Key" id="col_@col.Key" @checkedAttr />
                    <label for="col_@col.Key" class="form-check-label">@col.Label</label>
                </div>
            }
            
            <div class="d-grid mt-3">
                <button type="button" class="btn btn-primary btn-sm" id="btnApplyFilter">Terapkan</button>
            </div>
        </div>
    </div>

    <input type="hidden" name="fields" id="fieldsHidden" value="@string.Join(",", currentFields)" />
    <input type="hidden" name="page" id="pageHidden" value="@Model.Page" />
    <input type="hidden" name="pageSize" id="pageSizeHidden" value="@pageSize" />

    @* <button type="button" class="btn btn-outline-secondary ms-auto"><i class="bi bi-funnel me-1"></i> Filter</button> *@
</form>

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mobile-table">
        <thead class="table-light">
            <tr>
                <th scope="col" sort-key="name" class="border-end">
                    @Html.DisplayNameFor(model => model.Items[0].Name)
                </th>
                <th scope="col" sort-key="description" class="border-end">
                    @Html.DisplayNameFor(model => model.Items[0].Description)
                </th>
                <th scope="col" class="text-center">Aksi</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Items.Any() || Model == null) {
                <tr>
                    <td colspan="3" class="text-center">Tidak ada data</td>
                </tr>
            } else {
                foreach (var item in Model.Items) {
                    <tr>
                        <td class="d-flex d-md-table-cell" data-label="Name">
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td class="d-flex d-md-table-cell" data-label="Description">
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td class="text-center d-flex d-md-table-cell" data-label="Aksi">
                            <div class="row-actions">
                                <a class="btn btn-row" asp-action="Edit" asp-route-id="@item.DocumentTypeId" aria-label="Edit" title="Edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <form asp-action="DeleteConfirmed"
                                      asp-route-id="@item.DocumentTypeId"
                                      method="post"
                                      class="delete-form"
                                      data-loading-overlay="true"
                                      hx-boost="false"
                                      hx-ignore="true"
                                      data-confirm-title="Hapus @item.Name?"
                                      data-confirm-message="&quot;@item.Name&quot; akan dihapus. Admin bisa memulihkannya dari menu Data Terhapus."
                                      data-confirm-confirm="Hapus">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-row btn-row--danger" aria-label="Hapus" title="Hapus">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchBox = document.getElementById('searchBox');
            const fieldsHidden = document.getElementById('fieldsHidden');
            const pageHidden = document.getElementById('pageHidden');
            const pageSizeHidden = document.getElementById('pageSizeHidden');

            // Apply: collect selected columns, reset page to 1, submit
            document.getElementById('btnApplyFilter').addEventListener('click', function () {
                const cols = Array.from(document.querySelectorAll('.filter-col:checked')).map(c => c.value);
                fieldsHidden.value = cols.join(',');
                pageHidden.value = 1;
                form.submit();
            });

            // Submit search on Enter (reset to first page)
            searchBox.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    pageHidden.value = 1;
                    form.submit();
                }
            });

            // Refresh: clear filters, reset page to 1, submit
            document.getElementById('btnRefresh').addEventListener('click', function () {
                searchBox.value = '';
                fieldsHidden.value = '';
                pageHidden.value = 1;
                form.submit();
            });
        })();
    </script>
}
