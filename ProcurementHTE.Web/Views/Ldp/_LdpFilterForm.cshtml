@model ProcurementHTE.Web.Models.ViewModels.LdpIndexViewModel
<form method="get" id="filterForm" class="border rounded-3 d-flex flex-wrap gap-2 p-2 mb-3">
    <button type="button" class="btn btn-outline-secondary" id="btnRefresh">
        <i class="bi bi-arrow-clockwise"></i> Muat ulang
    </button>

    <div class="input-group flex-grow-1" style="max-width: 28rem;">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input aria-label="Cari" class="form-control" type="search" name="search" id="searchBox"
               placeholder="Cari berdasarkan No WO, Job Name, No SPK..." 
               value="@(Model.Search ?? "")" />
    </div>

    @await Component.InvokeAsync("PeriodFilter", new { source = "ldp" })

    <input type="hidden" name="page" id="pageHidden" value="@Model.Page" />
    <input type="hidden" name="pageSize" id="pageSizeHidden" value="@Model.PageSize" />
</form>
