@model ProcurementHTE.Web.Models.ViewModels.LdpIndexViewModel
<header class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div class="page-header-text">
        <h1 class="h3 mb-0">LDP - Laporan Data Procurement</h1>
        <p class="text-muted mb-0">Rekapitulasi semua data procurement dalam satu tabel</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-info fs-6">Total: @Model.Total data</span>
        <a href="@(Url.Action("Export", "Ldp") + Context.Request.QueryString)" class="btn btn-outline-primary" hx-boost="false">
            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Ekspor Excel
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Ldp" asp-action="Import" class="btn btn-outline-primary">
                <i class="bi bi-upload" aria-hidden="true"></i> Impor Excel
            </a>
            <a asp-controller="Procurements" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Tambah Pekerjaan
            </a>
        }
    </div>
</header>
