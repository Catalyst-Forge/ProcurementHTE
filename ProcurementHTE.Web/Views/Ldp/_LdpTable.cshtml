@model ProcurementHTE.Web.Models.ViewModels.LdpIndexViewModel
@{
    Func<DateTime?, string> formatDate = value => ProcurementHTE.Core.Finance.FinanceTable.FormatDate(value);
    Func<string?, string> formatText = value => !string.IsNullOrWhiteSpace(value) ? value : "-";
}
@* The LDP shows the main columns only. A job's name, or its eye icon, opens every column:
   Ldp/Details for a job run in Docutrax, LdpArchive/Details for an archived one.
   Aksi starts with the row's status: Done once every column here is filled (LdpProgress). *@
<div class="table-responsive border rounded-3 mb-2">
    <table id="ldpTable" class="table table-aligned table-hover align-middle mb-0 mobile-table finance-table ldp-table">
        <thead class="table-light">
            <tr class="align-middle">
                <th scope="col" sort-key="NoSpmp" filter-key="NoSpmp" class="border-end">SPMP</th>
                <th scope="col" sort-key="TextPekerjaan" filter-key="TextPekerjaan" class="border-end">Job Name</th>
                <th scope="col" sort-key="JobType" filter-key="JobType" class="border-end">Job Type</th>
                <th scope="col" sort-key="ContractType" filter-key="ContractType" class="border-end">Contract Type</th>
                <th scope="col" sort-key="ProjectRegion" filter-key="ProjectRegion" class="border-end">Project Region</th>
                <th scope="col" sort-key="TglMulai" sort-kind="date" filter-key="TglMulai" class="border-end">Start Date</th>
                <th scope="col" sort-key="NamaVendor" filter-key="NamaVendor" class="border-end">Vendor Terpilih</th>
                <th scope="col" sort-key="NoPr" filter-key="NoPr" class="border-end">No PR</th>
                <th scope="col" sort-key="NoPo" filter-key="NoPo" class="border-end">No PO</th>
                <th scope="col" sort-key="SANo" filter-key="SANo" class="border-end">No SA</th>
                <th scope="col" sort-key="SP3No" filter-key="SP3No" class="border-end">No SP3</th>
                <th scope="col" sort-key="TglSubmitLoket" sort-kind="date" filter-key="TglSubmitLoket" class="border-end">Submit Loket</th>
                <th scope="col" sort-key="Progress" filter-key="Progress">Aksi</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || !Model.Items.Any())
            {
                <tr>
                    <td colspan="13" class="text-center text-muted py-5">
                        <i class="bi bi-inbox display-4 text-muted d-block mb-3"></i>
                        @if (!string.IsNullOrWhiteSpace(Model?.Search))
                        {
                            <p class="mb-2">Tidak ditemukan data yang sesuai dengan pencarian "<strong>@Model.Search</strong>"</p>
                            <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-left"></i> Tampilkan Semua Data
                            </a>
                        }
                        else if (Context.Request.ReadListFilters().Count > 0)
                        {
                            <p class="mb-2">Tidak ada data yang cocok dengan filter</p>
                            <a href="@Context.Request.WithoutListFilters()" class="btn btn-outline-primary btn-sm">Hapus filter</a>
                        }
                        else
                        {
                            <p class="mb-0">Tidak ada data LDP yang tersedia</p>
                        }
                    </td>
                </tr>
            }
            else
            {
                var isAdmin = User.IsInRole("Admin");
                var returnUrl = Context.Request.Path + Context.Request.QueryString;
                foreach (var item in Model.Items)
                {
                    var archived = item.ArchiveRowId is not null;
                    var detailUrl = archived
                        ? Url.Action("Details", "LdpArchive", new { id = item.ArchiveRowId })
                        : Url.Action("Details", "Ldp", new { id = item.ProcurementId });
                    <tr>
                        <td data-label="SPMP" title="@item.NoSpmp">@(ProcurementHTE.Core.Finance.FinanceTable.ShortSpmp(item.NoSpmp) ?? "-")</td>
                        <td data-label="Job Name" class="finance-col-wrap text-start">
                            <a href="@detailUrl" class="fw-semibold text-decoration-none ldp-clamp" title="@item.TextPekerjaan">@formatText(item.TextPekerjaan)</a>
                        </td>
                        <td data-label="Job Type">@formatText(item.JobType)</td>
                        <td data-label="Contract Type">@formatText(item.ContractType)</td>
                        <td data-label="Project Region">@formatText(item.ProjectRegion)</td>
                        <td data-label="Start Date">@formatDate(item.TglMulai)</td>
                        <td data-label="Vendor Terpilih" class="finance-col-wrap"><span class="ldp-clamp" title="@item.NamaVendor">@formatText(item.NamaVendor)</span></td>
                        <td data-label="No PR">@formatText(item.NoPr)</td>
                        <td data-label="No PO">@formatText(item.NoPo)</td>
                        <td data-label="No SA">@formatText(item.SANo)</td>
                        <td data-label="No SP3">@formatText(item.SP3No)</td>
                        <td data-label="Submit Loket">@formatDate(item.TglSubmitLoket)</td>
                        <td data-label="Aksi">
                            <div class="finance-actions">
                                @await Html.PartialAsync("_FinanceStatus", (item.IsCancelled, item.Progress == ProcurementHTE.Core.Common.LdpProgress.Done))
                                <div class="row-actions">
                                    <a class="btn btn-row" href="@detailUrl" aria-label="Detail" title="Detail">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    @if (isAdmin && archived)
                                    {
                                        <a class="btn btn-row" asp-controller="LdpArchive" asp-action="Edit" asp-route-id="@item.ArchiveRowId" aria-label="Edit" title="Edit">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form asp-controller="LdpArchive" asp-action="Delete" asp-route-id="@item.ArchiveRowId" asp-route-returnUrl="@returnUrl"
                                              method="post" class="delete-form"
                                              data-confirm-title="Hapus pekerjaan ini?"
                                              data-confirm-message="Baris pindah ke Data Terhapus dan bisa dipulihkan dari sana."
                                              data-confirm-confirm="Hapus" data-confirm-cancel="Batal">
                                            <button type="submit" class="btn btn-row btn-row--danger" aria-label="Hapus" title="Hapus">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (isAdmin)
                                    {
                                        <a class="btn btn-row" asp-controller="Procurements" asp-action="Edit" asp-route-id="@item.ProcurementId" aria-label="Edit" title="Edit">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <a class="btn btn-row btn-row--danger" asp-controller="Procurements" asp-action="Delete" asp-route-id="@item.ProcurementId" aria-label="Hapus" title="Hapus">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)
