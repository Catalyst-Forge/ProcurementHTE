@model ProcurementHTE.Web.Models.ViewModels.LdpIndexViewModel
@{
    Func<decimal?, string> formatMoney = value => value.HasValue ? value.Value.ToString("N0") : "-";
    Func<DateTime?, string> formatDate = value => value?.ToString("dd MMM yyyy") ?? "-";
    Func<DateTime?, string> formatDateTime = value => value?.ToString("dd MMM yyyy HH:mm") ?? "-";
    Func<int?, string> formatYear = value => value?.ToString() ?? "-";
    Func<string?, string> formatText = value => !string.IsNullOrWhiteSpace(value) ? value : "-";
}
<div class="table-responsive border rounded-3 mb-2">
    <table id="ldpTable" class="table table-hover align-middle table-sm mb-0 mobile-table ldp-table" data-view="summary">
        <thead class="table-light">
            <tr class="align-middle text-center">
                <th class="border-end position-sticky start-0 bg-light ldp-pinned" style="--ldp-col-width: 60px; z-index: 2;">No</th>
                <th sort-key="NoWo" class="border-end ldp-pinned" style="--ldp-col-width: 120px;">No WO</th>
                <th sort-key="NoSpk" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 150px;">No SPK</th>
                <th sort-key="NamaVendor" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 150px;">Vendor Terpilih</th>
                <th sort-key="TglMulai" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 100px;">Tgl Mulai</th>
                <th sort-key="TglSelesai" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 100px;">Tgl Selesai</th>
                <th sort-key="TextPekerjaan" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 200px;">Job Name</th>
                <th sort-key="JobType" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 120px;">Job Type</th>
                <th sort-key="ContractType" class="border-end ldp-col ldp-summary" style="--ldp-col-width: 100px;">Contract Type</th>
                <th sort-key="LtcName" class="border-end ldp-col ldp-job" style="--ldp-col-width: 150px;">LTC Name</th>
                <th sort-key="TextPekerjaanPr" class="border-end ldp-col ldp-job" style="--ldp-col-width: 200px;">Text Pekerjaan PR</th>
                <th sort-key="Flag50K" class="border-end ldp-col ldp-job" style="--ldp-col-width: 80px;">50K</th>
                <th sort-key="NoAccrual" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 120px;">No Accrual</th>
                <th sort-key="YearJob" class="border-end ldp-col ldp-job" style="--ldp-col-width: 80px;">Year Job</th>
                <th sort-key="NoRig" class="border-end ldp-col ldp-job" style="--ldp-col-width: 120px;">No Rig</th>
                <th sort-key="NilaiPnl" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 120px;">Nilai PnL</th>
                <th sort-key="NilaiAccrual" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 120px;">Nilai Accrual</th>
                <th sort-key="NilaiRealisasi" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 120px;">Nilai Realisasi</th>
                <th sort-key="NoSpmp" class="border-end ldp-col ldp-job" style="--ldp-col-width: 120px;">No SPMP</th>
                <th sort-key="NoHte" class="border-end ldp-col ldp-job" style="--ldp-col-width: 120px;">No HTE</th>
                <th sort-key="ProjectRegion" class="border-end ldp-col ldp-job" style="--ldp-col-width: 100px;">Project Region</th>
                <th sort-key="ProjectCode" class="border-end ldp-col ldp-job" style="--ldp-col-width: 120px;">Project Code</th>
                <th sort-key="LinkDokumen" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 150px;">Link Dokumen</th>
                <th sort-key="UnitItemPenawaran" class="border-end ldp-col ldp-job" style="--ldp-col-width: 200px;">Unit Item</th>
                <th sort-key="SuratPenawaranVendor" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 150px;">Surat Penawaran</th>
                <th sort-key="Memorandum" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 120px;">Memorandum</th>
                <th sort-key="TglDoc" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 100px;">Tgl Doc</th>
                <th sort-key="Keterangan1" class="border-end text-nowrap ldp-col ldp-summary" style="--ldp-col-width: 150px;">Keterangan-1</th>
                <th sort-key="PotensiAccrual" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 120px;">Potensi Accrual</th>
                <th sort-key="TglAccrual" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 100px;">Tgl Accrual</th>
                <th sort-key="StatusAccrual" class="border-end ldp-col ldp-finance" style="--ldp-col-width: 100px;">Status Accrual</th>
                <th sort-key="RksTglSelesai" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 100px;">RKS Tgl Selesai</th>
                <th sort-key="BoqTglSelesai" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 100px;">BOQ Tgl Selesai</th>
                <th sort-key="MemoTglSelesai" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 100px;">Memo Tgl Selesai</th>
                <th sort-key="RaTglSelesai" class="border-end ldp-col ldp-docs" style="--ldp-col-width: 100px;">RA Tgl Selesai</th>
                <th sort-key="NoPr" class="border-end ldp-col ldp-pr" style="--ldp-col-width: 120px;">No PR</th>
                <th sort-key="TanggalBuatPr" class="border-end ldp-col ldp-pr" style="--ldp-col-width: 100px;">Tgl Buat PR</th>
                <th sort-key="TanggalRilisPr" class="border-end ldp-col ldp-pr" style="--ldp-col-width: 100px;">Tgl Rilis PR</th>
                <th sort-key="TanggalApprovalAnalyst" class="border-end ldp-col ldp-approval" style="--ldp-col-width: 120px;">Approval Analyst</th>
                <th sort-key="TanggalApprovalAsstManager" class="border-end ldp-col ldp-approval" style="--ldp-col-width: 120px;">Approval Asst. Man</th>
                <th sort-key="ManagerApprovalSelesai" class="border-end ldp-col ldp-approval" style="--ldp-col-width: 120px;">Approval Manager</th>
                <th sort-key="VpApprovalSelesai" class="border-end ldp-col ldp-approval" style="--ldp-col-width: 120px;">Approval VP</th>
                <th sort-key="TanggalSubmitIspa" class="border-end ldp-col ldp-pr" style="--ldp-col-width: 120px;">Tgl Submit INPRO</th>
                <th sort-key="SANo" class="border-end ldp-col ldp-pr" style="--ldp-col-width: 120px;">SA No</th>
                <th sort-key="SP3No" class="border-end ldp-col ldp-pr" style="--ldp-col-width: 120px;">SP3 No</th>
                <th class="position-sticky end-0 bg-light text-center ldp-pinned" style="--ldp-col-width: 140px; z-index: 2;">Aksi</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || !Model.Items.Any())
            {
                <tr>
                    <td colspan="46" class="text-center text-muted py-5">
                        <i class="bi bi-inbox display-4 text-muted d-block mb-3"></i>
                        @if (!string.IsNullOrWhiteSpace(Model?.Search))
                        {
                            <p class="mb-2">Tidak ditemukan data yang sesuai dengan pencarian "<strong>@Model.Search</strong>"</p>
                            <a href="@Url.Action("Index")" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-arrow-left"></i> Tampilkan Semua Data
                            </a>
                        }
                        else
                        {
                            <p class="mb-0">Tidak ada data LDP yang tersedia</p>
                        }
                    </td>
                </tr>
            }
            else
            {
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    var rowNumber = ((Model.Page - 1) * Model.PageSize) + i + 1;
                    <tr>
                        <td class="text-center position-sticky start-0 bg-white ldp-pinned" style="z-index: 1;">@rowNumber</td>
                        <td class="ldp-pinned">
                            @formatText(item.NoWo)
                            <small class="ldp-job-hint" title="@item.TextPekerjaan">@item.TextPekerjaan</small>
                        </td>
                        <td class="ldp-col ldp-summary">@formatText(item.NoSpk)</td>
                        <td class="ldp-col ldp-summary"><span class="ldp-clamp" title="@item.NamaVendor">@formatText(item.NamaVendor)</span></td>
                        <td class="text-center ldp-col ldp-summary">@formatDate(item.TglMulai)</td>
                        <td class="text-center ldp-col ldp-summary">@formatDate(item.TglSelesai)</td>
                        <td class="ldp-col ldp-summary"><span class="ldp-clamp" title="@item.TextPekerjaan">@formatText(item.TextPekerjaan)</span></td>
                        <td class="ldp-col ldp-summary">@formatText(item.JobType)</td>
                        <td class="ldp-col ldp-summary">@formatText(item.ContractType)</td>
                        <td class="ldp-col ldp-job"><span class="ldp-clamp" title="@item.LtcName">@formatText(item.LtcName)</span></td>
                        <td class="ldp-col ldp-job"><span class="ldp-clamp" title="@item.TextPekerjaanPr">@formatText(item.TextPekerjaanPr)</span></td>
                        <td class="text-center ldp-col ldp-job">@formatText(item.Flag50K)</td>
                        <td class="ldp-col ldp-finance">@formatText(item.NoAccrual)</td>
                        <td class="text-center ldp-col ldp-job">@formatYear(item.YearJob)</td>
                        <td class="ldp-col ldp-job">@formatText(item.NoRig)</td>
                        <td class="text-end ldp-col ldp-finance">@formatMoney(item.NilaiPnl)</td>
                        <td class="text-end ldp-col ldp-finance">@formatMoney(item.NilaiAccrual)</td>
                        <td class="text-end ldp-col ldp-finance">@formatMoney(item.NilaiRealisasi)</td>
                        <td class="ldp-col ldp-job">@formatText(item.NoSpmp)</td>
                        <td class="ldp-col ldp-job">@formatText(item.NoHte)</td>
                        <td class="ldp-col ldp-job">@formatText(item.ProjectRegion)</td>
                        <td class="ldp-col ldp-job">@formatText(item.ProjectCode)</td>
                        <td class="ldp-col ldp-docs">
                            @if (!string.IsNullOrWhiteSpace(item.LinkDokumen))
                            {
                                <small class="text-success"><i class="bi bi-check-circle"></i> Ada</small>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="ldp-col ldp-job"><span class="ldp-clamp" title="@item.UnitItemPenawaran">@formatText(item.UnitItemPenawaran)</span></td>
                        <td class="ldp-col ldp-docs">@formatText(item.SuratPenawaranVendor)</td>
                        <td class="ldp-col ldp-docs">@formatText(item.Memorandum)</td>
                        <td class="text-center ldp-col ldp-docs">@formatDate(item.TglDoc)</td>
                        <td class="ldp-col ldp-summary">@formatText(item.Keterangan1)</td>
                        <td class="text-end ldp-col ldp-finance">@formatMoney(item.PotensiAccrual)</td>
                        <td class="text-center ldp-col ldp-finance">@formatDate(item.TglAccrual)</td>
                        <td class="ldp-col ldp-finance">@formatText(item.StatusAccrual)</td>
                        <td class="text-center ldp-col ldp-docs">@formatDate(item.RksTglSelesai)</td>
                        <td class="text-center ldp-col ldp-docs">@formatDate(item.BoqTglSelesai)</td>
                        <td class="text-center ldp-col ldp-docs">@formatDate(item.MemoTglSelesai)</td>
                        <td class="text-center ldp-col ldp-docs">@formatDate(item.RaTglSelesai)</td>
                        <td class="ldp-col ldp-pr">@formatText(item.NoPr)</td>
                        <td class="text-center ldp-col ldp-pr">@formatDateTime(item.TanggalBuatPr)</td>
                        <td class="text-center ldp-col ldp-pr">@formatDateTime(item.TanggalRilisPr)</td>
                        <td class="text-center ldp-col ldp-approval">@formatDate(item.TanggalApprovalAnalyst)</td>
                        <td class="text-center ldp-col ldp-approval">@formatDate(item.TanggalApprovalAsstManager)</td>
                        <td class="text-center ldp-col ldp-approval">@formatDate(item.ManagerApprovalSelesai)</td>
                        <td class="text-center ldp-col ldp-approval">@formatDate(item.VpApprovalSelesai)</td>
                        <td class="text-center ldp-col ldp-pr">@formatDate(item.TanggalSubmitIspa)</td>
                        <td class="ldp-col ldp-pr">@formatText(item.SANo)</td>
                        <td class="ldp-col ldp-pr">@formatText(item.SP3No)</td>
                        <td class="position-sticky end-0 bg-white text-center ldp-pinned" style="z-index: 1;">
                            @if (item.HasLdpDocument)
                            {
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-download-ldp" 
                                            data-procurement-id="@item.ProcurementId"
                                            data-filename="@item.LdpFileName"
                                            title="Download Dokumen LDP">
                                        <i class="bi bi-download"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-warning btn-upload-ldp" 
                                            data-procurement-id="@item.ProcurementId"
                                            title="Ganti Dokumen LDP">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-delete-ldp" 
                                            data-procurement-id="@item.ProcurementId"
                                            data-filename="@item.LdpFileName"
                                            title="Hapus Dokumen LDP">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-primary btn-upload-ldp" 
                                        data-procurement-id="@item.ProcurementId"
                                        title="Upload Dokumen LDP">
                                    <i class="bi bi-upload me-1"></i>Upload
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)
