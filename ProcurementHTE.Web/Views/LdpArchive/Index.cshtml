@using System.Globalization
@model ProcurementHTE.Core.Common.PagedResult<ProcurementHTE.Core.Models.DTOs.LdpArchiveListItem>
@{
    ViewData["Title"] = "Arsip LDP";
    var search = Context.Request.Query["search"].ToString();
    var filtered = !string.IsNullOrWhiteSpace(search) || Context.Request.ReadListFilters().Count > 0;
    var isAdmin = User.IsInRole("Admin");
    var range = ViewData["LdpArchiveRange"] as ProcurementHTE.Core.Common.LdpArchiveRange ?? ProcurementHTE.Core.Common.LdpArchiveRange.Default;
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<header class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div class="page-header-text">
        <h1 class="h3 mb-0">Arsip LDP</h1>
        <p class="text-muted mb-0">Pekerjaan Completed dari Excel LDP. Yang mulai @range.Text tampil di LDP. Tidak masuk dashboard dan approval. Klik nama pekerjaan untuk semua kolomnya.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-info fs-6">Total: @Model.Total.ToString("N0", CultureInfo.GetCultureInfo("id-ID")) data</span>
        <a href="@(Url.Action("Export") + Context.Request.QueryString)" class="btn btn-outline-primary" hx-boost="false">
            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Ekspor Excel
        </a>
        @if (isAdmin)
        {
            <a asp-action="Range" class="btn btn-outline-primary"><i class="bi bi-calendar-range" aria-hidden="true"></i> Atur rentang</a>
            <a asp-action="Import" class="btn btn-outline-primary"><i class="bi bi-upload" aria-hidden="true"></i> Impor Excel</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Tambah</a>
        }
    </div>
</header>

<form method="get" class="border rounded-3 d-flex flex-wrap align-items-center gap-2 p-2 mb-3">
    <div class="input-group w-auto flex-grow-1 flex-sm-grow-0">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input aria-label="Cari arsip" class="form-control" type="search" name="search" value="@search"
               placeholder="Vendor, pekerjaan, No PR, No PO..." />
    </div>
    @foreach (var item in Context.Request.Query.Where(q => q.Key.StartsWith("f.") || q.Key is "sort" or "dir" or "pageSize"))
    {
        <input type="hidden" name="@item.Key" value="@item.Value" />
    }
    <button type="submit" class="btn btn-outline-primary">Cari</button>
    @await Component.InvokeAsync("PeriodFilter", new { source = "archive" })
    @if (filtered)
    {
        <a href="@Url.Action("Index")" class="btn btn-link">Hapus pencarian dan filter</a>
    }
</form>

<div class="column-filter-chips" data-column-filter-chips hidden></div>

@* The same columns as the LDP. A job's name, or its eye icon, opens every column of the row.
   The old spreadsheet has no Submit Loket, so that column stays "-" here. *@
<div class="table-responsive border rounded-3 mb-2">
    <table class="table table-aligned table-hover align-middle mb-0 mobile-table finance-table ldp-table">
        <thead class="table-light">
            <tr class="align-middle">
                <th scope="col" sort-key="NoSpmp" filter-key="NoSpmp" class="border-end">SPMP</th>
                <th scope="col" sort-key="JobName" filter-key="JobName" class="border-end">Job Name</th>
                <th scope="col" sort-key="JobType" filter-key="JobType" class="border-end">Job Type</th>
                <th scope="col" sort-key="ContractType" filter-key="ContractType" class="border-end">Contract Type</th>
                <th scope="col" class="border-end">Project Region</th>
                <th scope="col" sort-key="StartDate" sort-kind="date" filter-key="StartDate" class="border-end">Start Date</th>
                <th scope="col" sort-key="VendorName" filter-key="VendorName" class="border-end">Vendor Terpilih</th>
                <th scope="col" sort-key="NoPr" filter-key="NoPr" class="border-end">No PR</th>
                <th scope="col" sort-key="NoPo" filter-key="NoPo" class="border-end">No PO</th>
                <th scope="col" sort-key="NoSa" filter-key="NoSa" class="border-end">No SA</th>
                <th scope="col" sort-key="NoSp3" filter-key="NoSp3" class="border-end">No SP3</th>
                <th scope="col" class="border-end" title="Excel LDP lama tidak mencatat Submit Loket">Submit Loket</th>
                <th scope="col" sort-key="Progress" filter-key="Progress">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="13" class="text-center text-muted py-4">
                        @(filtered ? "Tidak ada arsip yang cocok." : "Arsip LDP belum diisi.")
                    </td>
                </tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td data-label="SPMP" title="@item.NoSpmp">@(ProcurementHTE.Core.Finance.FinanceTable.ShortSpmp(item.NoSpmp) ?? "-")</td>
                    <td data-label="Job Name" class="finance-col-wrap text-start">
                        <a asp-action="Details" asp-route-id="@item.Id" asp-route-from="arsip" class="fw-semibold text-decoration-none ldp-clamp" title="@item.JobName">@Text(item.JobName)</a>
                    </td>
                    <td data-label="Job Type">@Text(item.JobType)</td>
                    <td data-label="Contract Type">@Text(item.ContractType)</td>
                    <td data-label="Project Region">@Text(item.ProjectRegion)</td>
                    <td data-label="Start Date">@ProcurementHTE.Core.Finance.FinanceTable.FormatDate(item.StartDate)</td>
                    <td data-label="Vendor Terpilih" class="finance-col-wrap"><span class="ldp-clamp" title="@item.VendorName">@Text(item.VendorName)</span></td>
                    <td data-label="No PR">@Text(item.NoPr)</td>
                    <td data-label="No PO">@Text(item.NoPo)</td>
                    <td data-label="No SA">@Text(item.NoSa)</td>
                    <td data-label="No SP3">@Text(item.NoSp3)</td>
                    <td data-label="Submit Loket">-</td>
                    <td data-label="Aksi">
                        <div class="finance-actions">
                            @await Html.PartialAsync("_FinanceStatus", (false, item.Progress == ProcurementHTE.Core.Common.LdpProgress.Done))
                            <div class="row-actions">
                                <a class="btn btn-row" asp-action="Details" asp-route-id="@item.Id" asp-route-from="arsip" aria-label="Detail" title="Detail">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                                @if (isAdmin)
                                {
                                    <a class="btn btn-row" asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit" title="Edit">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                          method="post" class="delete-form"
                                          data-confirm-title="Hapus baris arsip ini?"
                                          data-confirm-message="Baris pindah ke Data Terhapus dan bisa dipulihkan dari sana."
                                          data-confirm-confirm="Hapus" data-confirm-cancel="Batal">
                                        <button type="submit" class="btn btn-row btn-row--danger" aria-label="Hapus" title="Hapus">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)

@section Scripts {
}
