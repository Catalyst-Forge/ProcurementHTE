@using ProcurementHTE.Core.Constants
@model ProcurementHTE.Web.Models.ViewModels.LdpArchiveFormModel
@{
    var isEdit = Model.Id is not null;
    ViewData["Title"] = isEdit ? "Edit Arsip LDP" : "Tambah Pekerjaan ke Arsip LDP";
    string InputType(string kind) => kind switch { "date" => "date", "number" => "number", _ => "text" };
    var trackingFields = ProcurementHTE.Core.Services.LdpArchiveTracking.Fields;
    var trackingProperties = trackingFields.Where(field => field.Property is not null).Select(field => field.Property!).ToHashSet();
    var trackingIndex = 0;
}

<header class="mb-3">
    <a href="@(isEdit ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))" class="back-link"><i class="bi bi-chevron-left" aria-hidden="true"></i>Kembali</a>
    <h1 class="h4 mt-2 mb-1">@ViewData["Title"]</h1>
    @if (isEdit)
    {
        <p class="text-muted small mb-0">Kalau baris ini berasal dari Excel, impor berikutnya akan menimpa perubahan di sini.</p>
    }
</header>

<form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    @* The same stages, in the same order, as the tracking on the detail page. A stage with a
       date shows as done there; an empty one stays open. *@
    <section class="card shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h2 class="h6 mb-1">Tanggal tracking</h2>
            <p class="text-muted small mb-3">Tahap yang diberi tanggal tampil selesai di tracking. Kosongkan untuk membukanya lagi.</p>
            <div class="row g-3">
                @foreach (var field in trackingFields)
                {
                    var id = $"tracking-{field.Step.Replace(' ', '-').Replace(".", "")}";
                    <div class="col-sm-6 col-md-4 col-xl-3">
                        <label for="@id" class="form-label">@field.Step</label>
                        @if (field.Property is { } property)
                        {
                            var name = $"Typed[{property}]";
                            <input id="@id" name="@name" type="date" class="form-control" value="@Model.Typed.GetValueOrDefault(property)" />
                            @Html.ValidationMessage(name, new { @class = "text-danger small" })
                        }
                        else
                        {
                            <input type="hidden" name="TrackingDates[@trackingIndex].Label" value="@field.Label" />
                            <input id="@id" name="TrackingDates[@trackingIndex].Value" type="date" class="form-control" value="@Model.TrackingDate(field.Label!)" />
                            trackingIndex++;
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="card shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">Kolom utama</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Status</label>
                    <input asp-for="Status" class="form-control" />
                </div>
                @foreach (var column in LdpArchiveColumns.Typed.Where(column => !trackingProperties.Contains(column.Property)))
                {
                    var name = $"Typed[{column.Property}]";
                    var id = $"typed-{column.Property}";
                    <div class="col-md-4">
                        <label for="@id" class="form-label">@column.Label</label>
                        <input id="@id" name="@name" type="@InputType(column.Kind)" class="form-control"
                               value="@Model.Typed.GetValueOrDefault(column.Property)"
                               step="@(column.Kind == "number" ? "any" : null)" />
                        @Html.ValidationMessage(name, new { @class = "text-danger small" })
                    </div>
                }
            </div>
        </div>
    </section>

    @if (Model.Others.Count > 0)
    {
        <section class="card shadow-sm rounded-4 mb-3">
            <div class="card-body">
                <h2 class="h6 mb-3">Kolom lain dari Excel</h2>
                <div class="row g-3">
                    @for (var i = 0; i < Model.Others.Count; i++)
                    {
                        <div class="col-md-4">
                            <input type="hidden" name="Others[@i].Label" value="@Model.Others[i].Label" />
                            <label for="other-@i" class="form-label">@Model.Others[i].Label</label>
                            <input id="other-@i" name="Others[@i].Value" class="form-control" value="@Model.Others[i].Value" />
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <div class="d-flex gap-2">
        <a href="@(isEdit ? Url.Action("Details", new { id = Model.Id }) : Url.Action("Index"))" class="btn btn-outline-secondary">Batal</a>
        <button type="submit" class="btn btn-primary">Simpan</button>
    </div>
</form>
