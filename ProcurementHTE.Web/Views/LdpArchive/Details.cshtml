@model ProcurementHTE.Web.Models.ViewModels.LdpArchiveDetailsViewModel
@{
    ViewData["Title"] = "Detail Arsip LDP";
    var row = Model.Row;
}

<header class="mb-3">
    <a asp-action="Index" class="small">Kembali ke Arsip LDP</a>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-2">
        <div>
            <h1 class="h4 mb-1 text-break">@(row.JobName ?? "Pekerjaan tanpa nama")</h1>
            <p class="text-muted mb-0 small">
                @row.Status · @(row.VendorName ?? "-") · No PR @(row.NoPr ?? "-")
                @(row.SourceKey is null ? " · ditambahkan manual" : $" · baris {row.SourceRow} di Excel")
            </p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@row.LdpArchiveRowId" class="btn btn-outline-secondary">Edit</a>
                <form asp-action="Delete" asp-route-id="@row.LdpArchiveRowId" method="post" class="delete-form"
                      data-confirm-title="Hapus baris arsip ini?"
                      data-confirm-message="Baris pindah ke Data Terhapus dan bisa dipulihkan dari sana."
                      data-confirm-confirm="Hapus" data-confirm-cancel="Batal">
                    <button type="submit" class="btn btn-outline-danger">Hapus</button>
                </form>
            </div>
        }
    </div>
</header>

<section class="card shadow-sm rounded-4" aria-label="Semua kolom dari Excel">
    <div class="card-body">
        @if (Model.Values.Count == 0)
        {
            <p class="text-muted mb-0">Tidak ada kolom tersimpan.</p>
        }
        else
        {
            <dl class="row mb-0">
                @foreach (var value in Model.Values)
                {
                    <dt class="col-sm-4 col-lg-3 fw-semibold text-secondary small">@value.Label</dt>
                    <dd class="col-sm-8 col-lg-9 text-break">@(string.IsNullOrWhiteSpace(value.Display) ? "-" : value.Display)</dd>
                }
            </dl>
        }
    </div>
</section>
