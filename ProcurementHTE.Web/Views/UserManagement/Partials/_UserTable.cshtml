@using ProcurementHTE.Web.Models.Admin
@model UserManagementIndexViewModel

<div class="table-responsive">
    <table class="table table-hover mb-0 align-middle mobile-table">
        <thead class="table-light">
            <tr>
                <th scope="col" sort-key="name">Nama</th>
                <th scope="col" sort-key="email">Email</th>
                <th scope="col" sort-key="jobTitle">Jabatan</th>
                <th scope="col">Roles</th>
                <th scope="col" sort-key="status">Status</th>
                <th scope="col" sort-key="twoFactor">2FA</th>
                <th scope="col" sort-key="lastLogin" sort-kind="date">Last Login</th>
                <th scope="col">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users.Any())
            {
                var currentUserId = User?.Claims?.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                foreach (var user in Model.Users)
                {
                    var isSelf = string.Equals(user.Id, currentUserId, StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td class="text-nowrap">@user.DisplayName</td>
                        <td>@user.Email</td>
                        <td>@user.JobTitle</td>
                        <td>
                            @if (user.Roles.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">@role</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">Nonaktif</span>
                            }
                        </td>
                        <td>
                            @if (user.TwoFactorEnabled)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">Aktif</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @(user.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                        <td class="text-center">
                            <div class="row-actions">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-row" aria-label="Edit user" title="Edit user">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="delete-form"
                                      data-confirm-title="@(user.IsActive ? $"Nonaktifkan {user.DisplayName}?" : $"Aktifkan {user.DisplayName}?")"
                                      data-confirm-message="@(user.IsActive ? "User langsung tidak bisa login dan semua sesinya diakhiri." : "User bisa login lagi.")"
                                      data-confirm-confirm="@(user.IsActive ? "Nonaktifkan" : "Aktifkan")"
                                      data-confirm-confirm-color="@(user.IsActive ? "var(--dx-danger)" : "var(--dx-blue-600)")"
                                      data-confirm-cancel="Batal">
                                    <button type="submit" class="btn btn-row btn-row--warning"
                                            aria-label="@(user.IsActive ? "Nonaktifkan user" : "Aktifkan user")"
                                            title="@(user.IsActive ? "Nonaktifkan user" : "Aktifkan user")"
                                            @(isSelf ? "disabled" : "")>
                                        <i class="bi bi-power" aria-hidden="true"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="delete-form"
                                      data-confirm-title="Hapus @user.DisplayName?"
                                      data-confirm-message="User langsung tidak bisa login. Admin bisa memulihkannya dari menu Data Terhapus."
                                      data-confirm-confirm="Hapus user"
                                      data-confirm-cancel="Batal">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-row btn-row--danger"
                                            aria-label="Hapus user"
                                            title="Hapus user"
                                            @(isSelf ? "disabled" : "")>
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4">
                        Tidak ada data user.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
