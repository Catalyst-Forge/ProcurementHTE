@using ProcurementHTE.Web.Models.Admin
@model UserManagementIndexViewModel

<nav>
    <ul class="pagination mb-0">
        @{
            var currentPage = Model.Filters.Page <= 0 ? 1 : Model.Filters.Page;
        }

        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link" href="@Context.Request.WithPage(currentPage - 1)">
                &laquo;
            </a>
        </li>

        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == currentPage ? "active" : "")">
                <a class="page-link" href="@Context.Request.WithPage(i)">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(currentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@Context.Request.WithPage(currentPage + 1)">
                &raquo;
            </a>
        </li>
    </ul>
</nav>
