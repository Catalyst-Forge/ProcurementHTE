@using ProcurementHTE.Core.Finance
@using ProcurementHTE.Web.Authorization
@using ProcurementHTE.Web.Models.ViewModels
@model ProcurementHTE.Core.Common.PagedResult<FinanceTableRow>
@{
    ViewData["Title"] = "Account Receivable";
    var canEdit = ActionRoles.Allows(User, ActionRoles.Ar);
    var canFillAccrual = ActionRoles.CanFillAccrual(User);
    string SaveUrl(FinanceTableRow row) => Url.Action("SaveField", "ArPickup", new { id = row.ProcurementId })!;
}

<header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Account Receivable</h1>
        <p class="text-muted mb-0">Klik PIC AR untuk mengisi. Data accrual diisi lewat tombol Isi Accrual. Status jadi Done setelah No Accrual dan PIC AR terisi.</p>
    </div>
</header>

@await Html.PartialAsync("_FinanceSearch", (string?)ViewBag.Search)
@Html.AntiForgeryToken()

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mb-0 mobile-table finance-table">
        <thead class="table-light">
            <tr class="align-middle">
                <th scope="col" sort-key="procNum" filter-key="procNum" class="border-end">Procurement No.</th>
                <th scope="col" sort-key="jobName" filter-key="jobName" class="border-end">Job Name</th>
                <th scope="col" sort-key="wonum" filter-key="wonum" class="border-end">WO Number</th>
                <th scope="col" sort-key="vendor" filter-key="vendor" class="border-end">Vendor</th>
                <th scope="col" sort-key="noAccrual" filter-key="noAccrual" class="border-end">No Accrual</th>
                <th scope="col" sort-key="potensiAccrual" sort-kind="number" class="border-end text-end">Potensi Accrual</th>
                <th scope="col" sort-key="statusAccrual" filter-key="statusAccrual" class="border-end">Status Accrual</th>
                <th scope="col" sort-key="picAr" filter-key="picAr" class="border-end">PIC AR</th>
                <th scope="col" sort-key="arStatus" filter-key="arStatus">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">Belum ada pekerjaan yang di-publish Operation</td>
                </tr>
            }
            @foreach (var row in Model.Items)
            {
                var hasAccrual = !string.IsNullOrWhiteSpace(row.NoAccrual);
                <tr>
                    <td data-label="Procurement No.">@row.ProcNum</td>
                    <td data-label="Job Name" class="finance-col-wrap">@row.JobName</td>
                    <td data-label="WO Number">@(string.IsNullOrWhiteSpace(row.Wonum) ? "-" : row.Wonum)</td>
                    <td data-label="Vendor" class="finance-col-wrap">@(row.Vendor ?? "-")</td>
                    <td data-label="No Accrual">@(hasAccrual ? row.NoAccrual : "-")</td>
                    <td data-label="Potensi Accrual" class="text-end">@FinanceTable.FormatMoney(row.PotensiAccrual)</td>
                    <td data-label="Status Accrual">@(string.IsNullOrWhiteSpace(row.StatusAccrual) ? "-" : row.StatusAccrual)</td>
                    <td data-label="PIC AR">@await Html.PartialAsync("_FinanceCell", new FinanceCellViewModel(SaveUrl(row), FinanceField.PicAr, row.PicAr, null, canEdit && !row.IsCancelled))</td>
                    <td data-label="Aksi">
                        <div class="finance-actions">
                            @await Html.PartialAsync("_FinanceStatus", (row.IsCancelled, row.ArDone))
                            @if (canFillAccrual && !row.IsCancelled)
                            {
                                <a asp-controller="Accrual" asp-action="Index" asp-route-search="@row.ProcNum" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-calculator" aria-hidden="true"></i> @(hasAccrual ? "Edit Accrual" : "Isi Accrual")
                                </a>
                            }
                            <a asp-action="Details" asp-route-id="@row.ProcurementId" class="btn btn-outline-info btn-sm"><i class="bi bi-eye" aria-hidden="true"></i> Detail</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)

@section Scripts {
    <script src="~/js/finance-table.js" asp-append-version="true"></script>
}
