@using System.Text.Json
@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var adminChartConfig = new
    {
        roleDistribution = Model.RoleDistribution,
        regionDistribution = Model.RegionDistribution
    };
}

<div class="container-fluid py-4" data-dashboard-realtime="true">
    @await Html.PartialAsync("_AdminDashboardHeader.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardStats.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardAccrualOverview.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardFinancialSummary.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardProcurementTables.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardCharts.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardUserActivity.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardTopVendors.cshtml", Model)
    @await Html.PartialAsync("_AdminDashboardRecentPurchaseRequisitions.cshtml", Model)
</div>

@section Scripts {
    @await Html.PartialAsync("~/Views/Dashboard/Partials/_DashboardChartsScripts.cshtml", Model)
    <script>
        window.adminDashboardConfig = @Html.Raw(JsonSerializer.Serialize(adminChartConfig, jsonOptions));
    </script>
    <script src="~/js/dashboard/admin/charts.js" asp-append-version="true"></script>
    <script src="~/js/dashboard/admin/users.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-realtime-ui.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-realtime.js" asp-append-version="true"></script>
}

@section HeadScripts {
    <link rel="stylesheet" href="~/css/dashboard-admin.css" asp-append-version="true" />
}
