@using ProcurementHTE.Core.Interfaces
@model List<PendingApprovalItem>
@{
    var listSort = Context.Request.ReadListSort();
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 15;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div data-total-count="@totalCount" hx-boost="false">
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-aligned table-hover mb-0 mobile-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col" sort-key="spmp" filter-key="spmp" class="px-3">SPMP</th>
                        <th scope="col" sort-key="wonum" filter-key="wonum">WO Number</th>
                        <th scope="col" sort-key="jobName" filter-key="jobName">Job Name</th>
                        <th scope="col" sort-key="status" filter-key="status" class="text-center">Status</th>
                        <th scope="col" sort-key="documentDate" filter-key="documentDate" sort-kind="date" class="text-center">Tanggal Dokumen</th>
                        <th scope="col" sort-key="sentAt" filter-key="sentAt" sort-kind="date" class="text-center">Dikirim</th>
                        <th scope="col" class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    <p class="mb-0">Tidak ada procurement yang menunggu approval Anda</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var statusBadgeClass = item.CurrentStatus switch
                            {
                                "WaitingApprovalAnalyst" => "bg-info",
                                "WaitingApprovalAsstManager" => "bg-warning text-dark",
                                "WaitingApprovalManager" => "bg-primary",
                                _ => "bg-secondary"
                            };
                            
                            <tr>
                                <td class="px-3">
                                    <a asp-controller="ProcurementTracking" 
                                       asp-action="Details" 
                                       asp-route-procurementId="@item.ProcurementId"
                                       class="fw-semibold text-decoration-none"
                                       hx-boost="false">
                                        @(ProcurementHTE.Core.Finance.FinanceTable.ShortSpmp(item.SpmpNumber) is { } spmp ? "SPMP " + spmp : "-")
                                    </a>
                                </td>
                                <td>
                                    <span class="text-muted">@item.Wonum</span>
                                </td>
                                <td class="text-start">
                                    <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.JobName">
                                        @item.JobName
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @statusBadgeClass">
                                        @item.CurrentStatusDescription
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="text-muted small">
                                        @item.DocumentDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.SentForApprovalAt.HasValue)
                                    {
                                        <span class="text-muted small" title="@item.SentForApprovalAt.Value.ToString("dd MMM yyyy HH:mm")">
                                            @GetTimeAgo(item.SentForApprovalAt.Value)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-controller="Procurements" 
                                           asp-action="Details" 
                                           asp-route-id="@item.ProcurementId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Lihat Detail Procurement"
                                           hx-boost="false">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="ProcurementTracking" 
                                           asp-action="Details" 
                                           asp-route-procurementId="@item.ProcurementId"
                                           class="btn btn-sm btn-success"
                                           title="Tinjau approval"
                                           hx-boost="false">
                                            <i class="bi bi-check2-circle me-1"></i>Review
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top" hx-boost="false">
                <div class="d-flex justify-content-center">
                    <partial name="_PageLinks" model="@(new ProcurementHTE.Web.Navigation.PageLinks(
                        currentPage,
                        totalPages,
                        target => Url.Action("PendingApprovals", "ProcurementTracking", new { sort = listSort?.Key, dir = listSort?.Descending == true ? "desc" : null, page = target, pageSize })!,
                        "Navigasi halaman persetujuan")
                    {
                        HxGet = target => Url.Action("PendingApprovals", "ProcurementTracking", new { sort = listSort?.Key, dir = listSort?.Descending == true ? "desc" : null, page = target, pageSize, partial = true })!,
                        HxTarget = "#pending-approvals-container",
                        HxIndicator = "#refresh-spinner",
                    })" />
                </div>
            </div>
        }
    </div>

    <div class="text-muted small text-center mt-3">
        Menampilkan @Model?.Count item dari @totalCount total
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var diff = DateTime.UtcNow - dateTime;
        if (diff.TotalMinutes < 1) return "Baru saja";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} menit lalu";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} jam lalu";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} hari lalu";
        return dateTime.ToString("dd MMM yyyy");
    }
}
