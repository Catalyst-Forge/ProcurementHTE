@using ProcurementHTE.Core.Models.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Masuk";
    Layout = "_LoginLayout";
    var captchaQuestion = ViewData["CaptchaQuestion"] as string ?? string.Empty;
    var formErrors = ViewData.ModelState.TryGetValue(string.Empty, out var formEntry)
        ? formEntry.Errors.Select(e => e.ErrorMessage).ToList()
        : new List<string>();
}

<div class="login">
  <section class="login-stage">
    <figure class="loop" aria-hidden="true">
      <svg class="loop-svg" viewBox="-60 -70 1120 630" focusable="false">
        <defs>
          <linearGradient id="dx-track" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0">
            <stop offset="0" stop-color="#2563EB" />
            <stop offset="0.5" stop-color="#0EA5D6" />
            <stop offset="1" stop-color="#14B8A6" />
          </linearGradient>
          <path id="dx-motion" d="M500,245 C410,140 320,40 217,40 C110,40 40,130 40,245 C40,360 110,450 217,450 C320,450 410,350 500,245 C590,140 680,40 783,40 C890,40 960,130 960,245 C960,360 890,450 783,450 C680,450 590,350 500,245 Z" />
          <g id="dx-doc">
            <path d="M-24,-26 Q-24,-31 -19,-31 L9,-31 L24,-16 L24,26 Q24,31 19,31 L-19,31 Q-24,31 -24,26 Z" fill="#FFFFFF" />
            <path d="M9,-31 L24,-16 L13,-16 Q9,-16 9,-20 Z" fill="#C9D6EA" />
            <rect x="-14" y="-7" width="28" height="5" rx="2.5" fill="#2563EB" />
            <rect x="-14" y="4" width="28" height="5" rx="2.5" fill="#C9D6EA" />
            <rect x="-14" y="15" width="18" height="5" rx="2.5" fill="#C9D6EA" />
          </g>
        </defs>

        <path class="loop-track" pathLength="1"
              d="M556,180 C626,100 700,40 783,40 C890,40 960,130 960,245 C960,360 890,450 783,450 C680,450 590,350 500,245 C410,140 320,40 217,40 C110,40 40,130 40,245 C40,360 110,450 217,450 C310,450 380,385 444,310" />

        <g class="loop-nodes">
          <circle cx="783" cy="40" r="15" />
          <circle cx="783" cy="450" r="15" />
          <circle cx="217" cy="40" r="15" />
          <circle cx="217" cy="450" r="15" />
        </g>

        <g class="loop-docs">
          @foreach (var begin in new[] { "0s", "-5.333s", "-10.667s" })
          {
            <use href="#dx-doc">
              <animateMotion dur="16s" begin="@begin" repeatCount="indefinite">
                <mpath href="#dx-motion" />
              </animateMotion>
            </use>
          }
        </g>
      </svg>

      <span class="loop-stage loop-stage--top" style="--x: 24.73%; --y: 17.46%">Purchase Requisition</span>
      <span class="loop-stage loop-stage--bottom" style="--x: 24.73%; --y: 82.54%">Approval berjenjang</span>
      <span class="loop-stage loop-stage--top" style="--x: 75.27%; --y: 17.46%">Vendor</span>
      <span class="loop-stage loop-stage--bottom" style="--x: 75.27%; --y: 82.54%">Purchase Order</span>
    </figure>

    <p class="login-tagline">Setiap dokumen pengadaan, terlacak dari PR sampai PO.</p>
  </section>

  <main class="login-panel">
    <div class="login-card">
      <picture>
        @* On narrow screens the band above already shows the infinity mark. *@
        <source media="(max-width: 991.98px)" srcset="~/images/docutrax-wordmark.webp" type="image/webp" />
        <source media="(max-width: 991.98px)" srcset="~/images/docutrax-wordmark.png" />
        <source srcset="~/images/docutrax-logo.webp" type="image/webp" />
        <img class="login-logo" src="~/images/docutrax-logo.png" alt="Docutrax" width="140" height="121" />
      </picture>

      <h1 class="login-title">Masuk ke Docutrax</h1>
      <p class="login-lede">Gunakan NIP atau email kantor Anda.</p>

      @if (formErrors.Count > 0)
      {
        <div class="login-alert" role="alert">
          <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
          <div>
            @foreach (var error in formErrors)
            {
              <p>@error</p>
            }
          </div>
        </div>
      }

      <form class="login-form" asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]" data-login-form novalidate>
        <div class="field">
          <label asp-for="Login" class="field-label"></label>
          <div class="field-control">
            <i class="bi bi-person-badge field-icon" aria-hidden="true"></i>
            <input asp-for="Login" class="field-input" autocomplete="username" autocapitalize="off" spellcheck="false"
                   placeholder="Masukkan NIP atau email" autofocus />
          </div>
          <span asp-validation-for="Login" class="field-error"></span>
        </div>

        <div class="field">
          <div class="field-row">
            <label asp-for="Password" class="field-label"></label>
            <a class="field-link" asp-action="ForgotPassword">Lupa password?</a>
          </div>
          <div class="field-control">
            <i class="bi bi-lock field-icon" aria-hidden="true"></i>
            <input asp-for="Password" class="field-input" autocomplete="current-password" placeholder="Masukkan password" />
            <button type="button" class="field-toggle" data-password-toggle aria-controls="Password"
                    aria-label="Tampilkan password" aria-pressed="false">
              <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
          </div>
          <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
          <label asp-for="CaptchaAnswer" class="field-label"></label>
          <div class="captcha">
            <output class="captcha-question" id="captcha-question" aria-live="polite" data-captcha-question>@captchaQuestion = ?</output>
            <div class="field-control captcha-answer">
              <input asp-for="CaptchaAnswer" type="text" value="" class="field-input" inputmode="numeric" pattern="[0-9]*"
                     maxlength="3" autocomplete="off" placeholder="Jawaban" aria-describedby="captcha-question" />
            </div>
            <button type="button" class="captcha-refresh" data-captcha-refresh data-url="@Url.Action("LoginCaptcha", "Auth")"
                    aria-label="Ganti soal captcha" title="Ganti soal">
              <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            </button>
          </div>
          <span asp-validation-for="CaptchaAnswer" class="field-error"></span>
        </div>

        <label class="check">
          <input asp-for="RememberMe" class="check-input" />
          <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
        </label>

        <button type="submit" class="login-submit" data-login-submit>
          <span class="login-submit-label">Masuk</span>
          <span class="login-submit-busy" aria-hidden="true"></span>
        </button>
      </form>
    </div>

    <p class="login-help">NIP belum terdaftar atau tidak bisa masuk? Hubungi admin Docutrax.</p>
  </main>
</div>
