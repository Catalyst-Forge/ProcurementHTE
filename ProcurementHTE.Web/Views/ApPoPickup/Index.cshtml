@using ProcurementHTE.Core.Enums
@using ProcurementHTE.Core.Finance
@using ProcurementHTE.Web.Authorization
@using ProcurementHTE.Web.Models.ViewModels
@model ProcurementHTE.Core.Common.PagedResult<FinanceTableRow>
@{
    ViewData["Title"] = "Account Payable Purchase Order";
    var canEdit = ActionRoles.Allows(User, ActionRoles.ApPo);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    string SaveUrl(FinanceTableRow row) => Url.Action("SaveField", "ApPoPickup", new { id = row.ProcurementId })!;
    FinanceCellViewModel Cell(FinanceTableRow row, FinanceField field, string? text, DateTime? date = null, decimal? money = null) =>
        new(SaveUrl(row), field, text, date, canEdit && !row.IsCancelled, money);
}

<header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Account Payable Purchase Order</h1>
        <p class="text-muted mb-0">
            Klik sel untuk mengisi. Status jadi Done setelah No PR, No PO, Submit INPRO, Submit Hard Copy, dan PIC APPO terisi.
        </p>
    </div>
</header>

@await Html.PartialAsync("_FinanceSearch", (string?)ViewBag.Search)
@Html.AntiForgeryToken()

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mb-0 mobile-table finance-table">
        <thead class="table-light">
            <tr class="align-middle">
                <th scope="col" sort-key="spmp" filter-key="spmp" class="border-end">SPMP</th>
                <th scope="col" sort-key="jobName" filter-key="jobName" class="border-end">Job Name</th>
                <th scope="col" sort-key="prNumber" filter-key="prNumber" class="border-end">No PR</th>
                <th scope="col" sort-key="nilaiPnl" sort-kind="number" class="border-end text-end">Nilai P&amp;L</th>
                <th scope="col" sort-key="nilaiAccrual" sort-kind="number" class="border-end">Nilai Accrual</th>
                <th scope="col" sort-key="nilaiRealisasi" sort-kind="number" class="border-end">Nilai Realisasi</th>
                <th scope="col" sort-key="poNumber" filter-key="poNumber" class="border-end">No PO</th>
                <th scope="col" sort-key="raNumber" filter-key="raNumber" class="border-end">No RA</th>
                <th scope="col" sort-key="inpro" sort-kind="date" class="border-end">Submit INPRO</th>
                <th scope="col" sort-key="hardcopy" sort-kind="date" class="border-end">Submit Hard Copy</th>
                <th scope="col" sort-key="picAppo" filter-key="picAppo" class="border-end">PIC APPO</th>
                <th scope="col" sort-key="apPoStatus" filter-key="apPoStatus">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="12" class="text-center text-muted py-4">Belum ada pekerjaan yang di-publish Operation</td>
                </tr>
            }
            @foreach (var row in Model.Items)
            {
                <tr>
                    <td data-label="SPMP" title="@row.Spmp">@(FinanceTable.ShortSpmp(row.Spmp) ?? "-")</td>
                    <td data-label="Job Name" class="finance-col-wrap">
                        <a href="@Url.Action("Index", "ProcurementDocuments", new { procurementId = row.ProcurementId })" class="fw-semibold text-decoration-none">@row.JobName</a>
                    </td>
                    <td data-label="No PR">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.PrNumber, row.PrNumber))</td>
                    <td data-label="Nilai P&amp;L" class="text-end">@FinanceTable.FormatMoney(row.NilaiPnl)</td>
                    <td data-label="Nilai Accrual" class="text-end">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.NilaiAccrual, null, money: row.NilaiAccrual))</td>
                    <td data-label="Nilai Realisasi" class="text-end">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.NilaiRealisasi, null, money: row.NilaiRealisasi))</td>
                    <td data-label="No PO">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.PoNumber, row.PoNumber))</td>
                    <td data-label="No RA">
                        @if (!row.RequiresRaNumber)
                        {
                            <span class="finance-cell-empty" title="Kontrak LTC dan RO tidak memakai RA">-</span>
                        }
                        else if (canEdit && row.CanChangeRaNumber)
                        {
                            var noRa = string.IsNullOrWhiteSpace(row.RaNumber);
                            <form asp-action="SaveRaNumber" asp-route-id="@row.ProcurementId" method="post">
                                <input type="hidden" name="raNumber" value="@row.RaNumber" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="button" class="finance-cell-edit btn-ra-number @(noRa ? "is-empty" : null)" aria-label="Ubah No RA" title="Ubah No RA">
                                    <span class="finance-cell-value">@(noRa ? "-" : row.RaNumber)</span>
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="@(string.IsNullOrWhiteSpace(row.RaNumber) ? "finance-cell-empty" : null)">@(string.IsNullOrWhiteSpace(row.RaNumber) ? "-" : row.RaNumber)</span>
                        }
                    </td>
                    <td data-label="Submit INPRO">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.InproDate, null, row.InproDate))</td>
                    <td data-label="Submit Hard Copy">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.HardcopyDate, null, row.HardcopyDate))</td>
                    <td data-label="PIC APPO" class="finance-col-name">@await Html.PartialAsync("_FinanceCell", Cell(row, FinanceField.PicAppo, row.PicAppo))</td>
                    <td data-label="Aksi">
                        <div class="finance-actions">
                            @await Html.PartialAsync("_FinanceStatus", (row.IsCancelled, row.ApPoDone))
                            @if (canEdit && row.CanSendApproval)
                            {
                                <form asp-action="SendApproval" asp-route-id="@row.ProcurementId" method="post" class="delete-form"
                                      data-confirm-title="@($"Sending approval {row.NextApprovalTarget}?")"
                                      data-confirm-message="@($"{row.JobName} dikirim ke {row.NextApprovalTarget} untuk approval.")"
                                      data-confirm-confirm="Kirim"
                                      data-confirm-confirm-color="var(--dx-blue-600)"
                                      data-confirm-cancel="Batal">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-primary finance-send">
                                        <span class="finance-keep">Sending Approval</span> <span class="finance-keep">@row.NextApprovalTarget</span>
                                    </button>
                                </form>
                            }
                            else if (canEdit && row.NeedsProfitLossToSend)
                            {
                                <span class="finance-stage finance-stage--warning">
                                    <span class="finance-keep"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>Isi P&amp;L dulu</span> <span class="finance-keep">untuk kirim approval</span>
                                </span>
                            }
                            else if (row.WaitingOn != null)
                            {
                                <span class="finance-stage">
                                    <span class="finance-keep"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Menunggu approval</span> <span class="finance-keep">@row.WaitingOn</span>
                                </span>
                            }
                            else if (row.Stage != ProcurementStatus.OnCreateDP3)
                            {
                                <span class="finance-stage">@FinanceTable.StageLabel(row.Stage)</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)

@section Scripts {
    <script src="~/js/finance-table.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('.btn-ra-number').forEach(btn => {
            btn.addEventListener('click', function () {
                const form = this.closest('form');
                const input = form.querySelector('input[name="raNumber"]');
                Swal.fire({
                    title: 'Nomor RA',
                    input: 'text',
                    inputValue: input.value,
                    inputAttributes: { maxlength: 100, 'aria-label': 'Nomor RA' },
                    inputValidator: value => value.trim() ? null : 'Nomor RA wajib diisi',
                    showCancelButton: true,
                    confirmButtonText: 'Simpan',
                    cancelButtonText: 'Batal',
                    confirmButtonColor: 'var(--dx-blue-600)',
                    cancelButtonColor: 'var(--dx-ink-muted)',
                    reverseButtons: true
                }).then(result => {
                    if (result.isConfirmed) {
                        input.value = result.value.trim();
                        form.submit();
                    }
                });
            });
        });
    </script>
}
