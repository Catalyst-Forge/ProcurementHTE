<div class="modal fade pr-submit-modal" id="submitInproModal" tabindex="-1" aria-labelledby="submitInproTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="SubmitInpro" method="post" enctype="multipart/form-data" hx-boost="false" class="modal-content" data-loading-overlay="true">
            @Html.AntiForgeryToken()
            <input type="hidden" name="prId" />
            <div class="modal-header">
                <h2 class="modal-title h5" id="submitInproTitle">Submit INPRO</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Berlaku untuk semua pekerjaan di PR <span data-pr-number></span>.</p>
                <div class="mb-3">
                    <label class="form-label" for="inproNumber">Nomor INPRO</label>
                    <input class="form-control" id="inproNumber" name="inproNumber" required />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="inproDate">Tanggal INPRO</label>
                        <input class="form-control" id="inproDate" type="date" name="inproDate" required />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="inproSubmitDate">Tanggal Submit INPRO</label>
                        <input class="form-control" id="inproSubmitDate" type="date" name="inproSubmitDate" required />
                    </div>
                </div>
                <label class="form-label" for="inproFile">Dokumen INPRO (PDF)</label>
                <input class="form-control" id="inproFile" type="file" name="inproFile" accept="application/pdf,.pdf" required />
                <small class="form-text text-muted">Maksimal 50MB</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                <button type="submit" class="btn btn-primary">Submit INPRO</button>
            </div>
        </form>
    </div>
</div>

