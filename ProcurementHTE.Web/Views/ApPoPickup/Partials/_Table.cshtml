@using ProcurementHTE.Core.Common
@using ProcurementHTE.Core.Models
@model PagedResult<Procurement>
@{
    var canPickup = ProcurementHTE.Web.Authorization.ActionRoles.Allows(User, ProcurementHTE.Web.Authorization.ActionRoles.ApPo);
    var isMyPickups = (bool)(ViewData["IsMyPickups"] ?? false);
    var prStates = ViewData["PrStates"] as Dictionary<string, ProcurementHTE.Core.Models.DTOs.PrSubmitState> ?? [];
    var badgeClass = ViewData["BadgeClass"] as Func<string, string> ?? (s => "bg-light text-body border");
}

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mobile-table">
        <thead class="table-light">
            <tr class="align-middle">
                <th sort-key="procNum" class="border-end">Procurement No.</th>
                <th sort-key="jobName" class="border-end">Job Name</th>
                <th sort-key="wonum" class="border-end">WO Number</th>
                <th sort-key="startDate" sort-kind="date" class="border-end">Start Date</th>
                <th sort-key="jobType" class="border-end">Job Type</th>
                <th sort-key="region" class="border-end">Project Region</th>
                <th sort-key="raNumber" class="border-end">RA Number</th>
                <th sort-key="status" class="border-end">Status</th>
                <th class="text-center width-15-rem">Action</th>
            </tr>
        </thead>

        <tbody>
            @if (Model == null || !Model.Items.Any()) {
                <tr>
                    <td colspan="9" class="text-center text-muted">
                        @if (isMyPickups) {
                            <text>Belum ada procurement yang Anda pickup</text>
                        } else {
                            <text>Tidak ada procurement yang perlu di-pickup</text>
                        }
                    </td>
                </tr>
            } else {
                foreach (var item in Model.Items) {
                    var wonum = string.IsNullOrWhiteSpace(item.Wonum) ? "-" : item.Wonum;

                    <tr>
                        <td data-label="Procurement No.">
                            @item.ProcNum
                        </td>
                        <td data-label="Job Name">
                            @item.JobName
                        </td>
                        <td data-label="WO Number">
                            @wonum
                        </td>
                        <td data-label="Start Date">
                            @(item.StartDate == default ? "-" : item.StartDate.ToString("dd MMM yyyy"))
                        </td>
                        <td data-label="Job Type">
                            @(item.JobType?.TypeName ?? "-")
                        </td>
                        <td data-label="Project Region">
                            @item.ProjectRegion
                        </td>
                        <td data-label="RA Number">
                            @if (!item.RequiresRaNumber) {
                                <span class="text-muted">Tidak perlu</span>
                            } else {
                                <span>@(string.IsNullOrWhiteSpace(item.RaNumber) ? "-" : item.RaNumber)</span>
                                @if (isMyPickups && canPickup && item.CanChangeRaNumber) {
                                    <form method="post" asp-action="SaveRaNumber" asp-route-id="@item.ProcurementId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="raNumber" value="@item.RaNumber" />
                                        <button type="button" class="btn btn-outline-primary btn-sm ms-1 btn-ra-number" data-procnum="@item.ProcNum">
                                            @(string.IsNullOrWhiteSpace(item.RaNumber) ? "Isi" : "Ubah")
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                        <td data-label="Status">
                            <span class="badge @badgeClass(item.Status?.StatusName ?? string.Empty)">
                                @(item.Status?.StatusName ?? "-")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.ProcurementId" 
                               class="btn btn-outline-info btn-sm me-1" title="View Details">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            @if (!isMyPickups) {
                                @if (canPickup) {
                                    <form method="post" asp-action="Pickup" asp-route-id="@item.ProcurementId" style="display: inline;" class="pickup-form">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-success btn-sm btn-pickup" data-procnum="@item.ProcNum">
                                            <i class="bi bi-box-arrow-in-down"></i> Pickup
                                        </button>
                                    </form>
                                }
                            } else if (canPickup && item.PrId == null && item.ProcurementStatus != ProcurementHTE.Core.Enums.ProcurementStatus.Cancelled) {
                                <a asp-controller="PurchaseRequisitions" asp-action="Create" class="btn btn-success btn-sm">
                                    <i class="bi bi-journal-plus"></i> Create PR
                                </a>
                            } else if (canPickup && item.PrId != null && item.ProcurementStatus != ProcurementHTE.Core.Enums.ProcurementStatus.Cancelled && prStates.TryGetValue(item.PrId, out var prState) && prState.Step != null) {
                                var (stepLabel, stepModal) = prState.Step switch {
                                    ProcurementHTE.Core.Enums.ProcurementStatus.OnSubmitISPA => ("Submit INPRO", "#submitInproModal"),
                                    ProcurementHTE.Core.Enums.ProcurementStatus.OnSubmitHardcopy => ("Upload Hardcopy", "#submitHardcopyModal"),
                                    _ => ("Done PO", "#submitPoModal"),
                                };
                                <button type="button" class="btn btn-primary btn-sm"
                                        data-bs-toggle="modal" data-bs-target="@stepModal"
                                        data-pr-id="@item.PrId" data-pr-number="@prState.PrNumber">
                                    @stepLabel
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
