@model ProcurementHTE.Web.Models.ViewModels.AccrualIndexViewModel
@{
    string FormatMoney(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "-";
    string FormatDate(DateTime? date) => date.HasValue ? date.Value.ToString("dd MMM yyyy") : "-";
}

<!-- Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 mobile-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 50px;">#</th>
                        <th scope="col" sort-key="wonum">No WO</th>
                        <th scope="col" sort-key="jobName">Job Name</th>
                        <th scope="col" sort-key="vendor">Vendor</th>
                        <th scope="col" sort-key="accrualStatus">Status Accrual</th>
                        <th scope="col" sort-key="noAccrual">No Accrual</th>
                        <th scope="col" sort-key="potensiAccrual" sort-kind="number" class="text-end">Potensi Accrual</th>
                        <th scope="col" sort-key="filledBy">Diisi Oleh</th>
                        <th scope="col" class="text-center" style="width: 120px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Procurements.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Tidak ada data ditemukan
                            </td>
                        </tr>
                    }
                    else
                    {
                        var rowNum = (Model.CurrentPage - 1) * Model.PageSize;
                        @foreach (var item in Model.Procurements)
                        {
                            rowNum++;
                            var vendor = item.ProfitLosses.FirstOrDefault()?.SelectedVendor?.VendorName ?? "-";
                            var hasAccrual = !string.IsNullOrEmpty(item.NoAccrual);
                            var isPickedByAr = !string.IsNullOrEmpty(item.ArUserId);

                            <tr>
                                <td>@rowNum</td>
                                <td><code>@(item.Wonum ?? "-")</code></td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@item.JobName">
                                        @item.JobName
                                    </span>
                                </td>
                                <td>@vendor</td>
                                <td>
                                    @if (hasAccrual)
                                    {
                                        <span class="badge bg-success">@(item.StatusAccrual ?? "Filled")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>@(item.NoAccrual ?? "-")</td>
                                <td class="text-end">@FormatMoney(item.PotensiAccrual)</td>
                                <td>
                                    @if (item.AccrualFilledByUser != null)
                                    {
                                        <small class="text-muted">
                                            @item.AccrualFilledByUser.FullName<br />
                                            <span class="text-secondary">@FormatDate(item.AccrualFilledAt)</span>
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (ProcurementHTE.Web.Authorization.ActionRoles.CanFillAccrual(User, isPickedByAr))
                                    {
                                        <button type="button"
                                                class="btn btn-sm @(hasAccrual ? "btn-outline-primary" : "btn-primary") btn-edit-accrual"
                                                data-procurement-id="@item.ProcurementId"
                                                data-bs-toggle="modal"
                                                data-bs-target="#accrualModal">
                                            <i class="bi @(hasAccrual ? "bi-pencil" : "bi-plus-lg")"></i>
                                            @(hasAccrual ? "Edit" : "Isi Data")
                                        </button>
                                    }
                                    else if (User.IsInRole("AR") && !isPickedByAr)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle"></i> Pickup Dulu
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hanya lihat</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-center">
            <partial name="_PageLinks" model="@(new ProcurementHTE.Web.Navigation.PageLinks(Model.CurrentPage, Model.TotalPages, target => Context.Request.WithPage(target)))" />
        </div>
    }
</div>
