@using ProcurementHTE.Core.Finance
@using ProcurementHTE.Web.Authorization
@using ProcurementHTE.Web.Models.ViewModels
@model ProcurementHTE.Core.Common.PagedResult<FinanceTableRow>
@{
    ViewData["Title"] = "Data Accrual";
    var canEdit = ActionRoles.Allows(User, ActionRoles.Accrual);
    string SaveUrl(FinanceTableRow row) => Url.Action("SaveField", "Accrual", new { id = row.ProcurementId })!;
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Data Accrual</h1>
        <p class="text-muted mb-0">Klik No Accrual untuk mengisi. Status jadi Done setelah No Accrual terisi.</p>
    </div>
</header>

@await Html.PartialAsync("_FinanceSearch", (string?)ViewBag.Search)
@Html.AntiForgeryToken()

<div class="table-responsive border rounded-3">
    <table class="table table-hover align-middle mb-0 mobile-table finance-table">
        <thead class="table-light">
            <tr class="align-middle">
                <th scope="col" sort-key="spmp" filter-key="spmp" class="border-end">SPMP</th>
                <th scope="col" sort-key="jobName" filter-key="jobName" class="border-end">Job Name</th>
                <th scope="col" sort-key="prNumber" filter-key="prNumber" class="border-end">No PR</th>
                <th scope="col" sort-key="nilaiPnl" sort-kind="number" class="border-end text-end">Nilai P&amp;L</th>
                <th scope="col" sort-key="nilaiAccrual" sort-kind="number" class="border-end text-end">Nilai Accrual</th>
                <th scope="col" sort-key="nilaiRealisasi" sort-kind="number" class="border-end text-end">Nilai Realisasi</th>
                <th scope="col" sort-key="noAccrual" filter-key="noAccrual" class="border-end">No Accrual</th>
                <th scope="col" sort-key="accrualTableStatus" filter-key="accrualTableStatus">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Belum ada pekerjaan yang di-publish Operation</td>
                </tr>
            }
            @foreach (var row in Model.Items)
            {
                <tr>
                    <td data-label="SPMP" title="@row.Spmp">@(FinanceTable.ShortSpmp(row.Spmp) ?? "-")</td>
                    <td data-label="Job Name" class="finance-col-wrap">@row.JobName</td>
                    <td data-label="No PR">@Text(row.PrNumber)</td>
                    <td data-label="Nilai P&amp;L" class="text-end">@FinanceTable.FormatMoney(row.NilaiPnl)</td>
                    <td data-label="Nilai Accrual" class="text-end">@FinanceTable.FormatMoney(row.NilaiAccrual)</td>
                    <td data-label="Nilai Realisasi" class="text-end">@FinanceTable.FormatMoney(row.NilaiRealisasi)</td>
                    <td data-label="No Accrual">@await Html.PartialAsync("_FinanceCell", new FinanceCellViewModel(SaveUrl(row), FinanceField.NoAccrual, row.NoAccrual, null, canEdit && !row.IsCancelled))</td>
                    <td data-label="Aksi">@await Html.PartialAsync("_FinanceStatus", (row.IsCancelled, row.AccrualDone))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager", Model)

@section Scripts {
    <script src="~/js/finance-table.js" asp-append-version="true"></script>
}
